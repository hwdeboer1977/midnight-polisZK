{
  "name": "midnight-polisZK",
  "version": "1.0.0",
  "type": "module",
  "description": "A Midnight Network application created with create-midnight-app",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --config nodemon.json",
    "watch": "nodemon --config nodemon.json",
    "setup": "npm run compile && npm run build && npm run deploy",
    "compile": "compact compile contracts/hello-world.compact contracts/managed/hello-world",
    "build": "tsc",
    "deploy": "npm run build && node dist/deploy.js",
    "cli": "npm run build && node dist/cli.js",
    "check-balance": "npm run build && node dist/check-balance.js",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "proof:up": "docker run -d --name proof-server --restart unless-stopped -p 6300:6300 midnightntwrk/proof-server:8.1.0 midnight-proof-server -v",
    "proof:down": "docker stop proof-server && docker rm proof-server",
    "reset": "rm -rf contracts/managed deployment.json dist && npm run compile",
    "validate": "tsc --noEmit && npm run compile",
    "clean": "rm -rf dist contracts/managed deployment.json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.3.1",
    "effect": "^3.22.1",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "nodemon": "^3.0.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy"
  ]
}
