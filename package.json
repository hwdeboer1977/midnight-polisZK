{
  "name": "midnight-polisZK",
  "version": "1.0.0",
  "type": "module",
  "description": "A Midnight Network application created with create-midnight-app",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --config nodemon.json",
    "watch": "nodemon --config nodemon.json",
    "compile": "for f in contracts/*.compact; do n=$(basename \"$f\" .compact); echo \"compiling $n\"; compact compile \"$f\" \"contracts/managed/$n\" || exit 1; done",
    "build": "tsc",
    "deploy": "npm run build && node dist/deploy.js",
    "check-balance": "npm run build && node dist/check-balance.js",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "proof:up": "docker run -d --name proof-server --restart unless-stopped -p 6300:6300 midnightntwrk/proof-server:8.1.0 midnight-proof-server -v",
    "proof:down": "docker stop proof-server && docker rm proof-server",
    "reset": "rm -rf contracts/managed deployment.json dist && npm run compile",
    "validate": "tsc --noEmit && npm run compile",
    "clean": "rm -rf dist contracts/managed deployment.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "deploy:payroll": "npm run build && CONTRACT_NAME=payroll node dist/deploy.js",
    "payroll": "npm run build && node dist/payroll-cli.js",
    "wallet:reset": "rm -rf .wallet-state",
    "deploy:peur": "npm run build && CONTRACT_NAME=peur node dist/deploy.js",
    "peur": "npm run build && node dist/peur-cli.js",
    "frontend:config": "npm run build && node dist/frontend-config.js",
    "frontend": "npm run frontend:config && npm --prefix frontend run dev",
    "frontend:build": "npm run frontend:config && npm --prefix frontend run build",
    "roster:template": "npm run build && node dist/make-template.js",
    "onboard": "npm run build && node dist/onboard.js",
    "demo:server": "npm run build && node dist/demo-server.js",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "registry": "npm run build && node dist/registry-cli.js"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@scure/bip39": "^2.3.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.3.1",
    "effect": "^3.22.1",
    "exceljs": "^4.4.0",
    "pg": "^8.23.0",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.10",
    "nodemon": "^3.0.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "blockchain",
    "zero-knowledge",
    "privacy"
  ]
}
