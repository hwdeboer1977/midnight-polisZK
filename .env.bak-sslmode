# Midnight Network Configuration

# Network: local | preprod | preview
# Set this to match your wallet: the address prefix tells you which network it
# is on (mn_addr_preprod1... vs mn_addr_preview1...).
#MIDNIGHT_NETWORK=local
MIDNIGHT_NETWORK=preview
WALLET_MNEMONIC="fence cart dirt antique capital two priority lab once where arrange use void upgrade bubble derive topple this luxury tunnel deal record jazz saddle"

PROOF_SERVER_URL=http://127.0.0.1:6300

# Reference only — nothing reads these. deployment.json is the source of truth,
# and frontend/public/deployments.json is what the UI reads. Kept in sync by hand,
# so treat a mismatch here as this file being stale, never the other way round.

# Contract address payroll (varies per registered employer)
# payroll_address=8758b2cbbf3b0d6b0b64a5f612d3911391b9c52075f864011f918715ffe2e780

