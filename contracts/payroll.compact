pragma language_version >= 0.16;

import CompactStandardLibrary;

// Payroll for one employer with a fixed roster of 2 employees.

// The platform operator deploys the contract for each employer and names the employer. 
// From then on only that employer can write payroll — the platform cannot, not even after
// revoking them.
//
// The employer seat can be vacated (`revokeEmployer`) and refilled
// (`assignEmployer`), so a lapsed subscription can be ended and later restored
// on the same contract.
//
// PRIVACY: individual salaries are circuit inputs — they never leave the
// employer's machine, only the proof does. The chain sees the headcount, the
// monthly totals, and one commitment per employee.
//
// The whole roster is filed in ONE call for that reason. One call per employee
// would move the public total by exactly that person's salary, and anyone
// watching blocks could read every individual amount off the deltas.

// Employer files, funds and remits:
// 1. File: setPayroll computes the figures and writes totalTaxFor[p], totalSocialFor[p]. Nothing moves. This is assessment only.
// 2. Fund: fundWithholding is where money actually arrives. 
// The employer sends two coins, and the circuit enforces taxCoin.value == totalTaxFor[p] and socialCoin.value == totalSocialFor[p] exactly. 
// Then taxPool += totalTaxFor[p] and withheldFor[p] = true. So "collected" happens here, not at filing.
// 3.Remit — remit(period, isTax, treasury, coin) sends one period's tax or social to its frozen treasury, one call each. It subtracts from the pool and adds to taxRemitted.

// Struct TaxParams: holds tax parameters for payroll calculations.
struct TaxParams {
  version: Uint<16>;
  validFrom: Uint<32>;
  threshold1: Uint<60>;
  threshold2: Uint<60>;
  rate1: Uint<16>;
  rate2: Uint<16>;
  rate3: Uint<16>;
  maxContribBase: Uint<60>;
  contribRate: Uint<16>;
}


// Struct PayrollCommitment: One commitment per employee
// Hashed so the employer can later prove the amount paid without making it public.
// Committing to gross salary alone would leave the split unprovable: an
// employer could publish any tax total it liked and no commitment would
// contradict it. Hashing all four together (gross, tax, social, net) means the public column totals and
// the per-employee openings cannot disagree.
struct PayrollCommitment {
  gross: Uint<60>;
  tax: Uint<60>;
  social: Uint<60>;
  net: Uint<60>;
  // Weeks: weeks worked in the period: employment history determines duration unemployment benefit
  weeks: Uint<8>;
  // Period: bound inside the hash so an attestation cannot be replayed into another month.
  // Employer: same, so a commitment from one employer's instance cannot be presented as if it came from another.
  period: Uint<32>;
  employer: ZswapCoinPublicKey;
  // ParamsHash: which published tax rules produced these figures, so a claim
  // can check the arithmetic against the right version.
  paramsHash: Bytes<32>;
  // Nonce: Random per employee per period. Without it the commitment is guessable:
  // salaries fall in a narrow range, so anyone could hash candidate figures
  // until one matched.
  nonce: Bytes<32>;
}

// Struct Termination: the employer's statement that someone's employment ended.
// Hashed into `terminationFor`, write-once: fixed before anyone acts on it,
// auditable afterwards. Declared here only — `fund.compact` has no matching
// struct and never reads `terminationFor`; its claim checks a `ClaimLeaf`
// against a published merkle root instead.
struct Termination {
  // The last period worked — where the employment record ends.
  finalPeriod: Uint<32>;
  // Total months of employment, which is what determines benefit duration.
  monthsWorked: Uint<16>;
  // Random, so the hash can't be brute-forced: without it, the other two fields
  // have few enough plausible values to enumerate.
  nonce: Bytes<32>;
}

// Struct PayeeBinding: identifies who gets paid, without publishing their key.
//
// `payeeFor` stores hash(payee, period, instance) instead of the payee's public
// key. The period and contract address are included so the same person hashes
// to a different value each month and on each contract — otherwise one binding
// could be reused elsewhere.
//
// Note what this does and does not hide. The period and address are public, so
// anyone who guesses a candidate key can hash it themselves and see if it
// matches. It hides the payee from someone with no idea who it is; it does not
// hide them from someone with a good guess.
//
// That is on purpose. The employee has to find their own entries: they know
// their key, the month and the address, so they hash those and scan for a
// match. Adding a random nonce would hide the payee properly — but then the
// employer must send each employee a secret every period (less user experience)
struct PayeeBinding {
  payee: ZswapCoinPublicKey;
  period: Uint<32>;
  // `contract` is a reserved word in Compact, hence the name.
  instance: Bytes<32>;
}



// ⚠️ ROSTER SIZE IS 2, hard-coded throughout.
//
// Compact has no top-level constants and vector lengths are compile-time, so
// the size appears in every `Vector<N, …>`, every `0..N` loop, and
// `employeeCountFor`. The per-employee tax calculation in `setPayroll` is also
// written out once per slot (`g0`/`net0`, `g1`/`net1`). Changing the size means
// editing all of it and REDEPLOYING — verifier keys are fixed at deploy.
//
// It cannot be made dynamic. A proof is over a fixed-size circuit, and this
// contract's privacy depends on every salary entering ONE circuit together —
// filing per employee would leak each amount through the public total's delta.
// Scaling properly means a merkle roster with per-employee inclusion proofs,
// not a bigger vector: padding to a maximum would cost the full proving time
// every month, and this contract already sits near the block limit.



// The operator who deployed this instance. Controls the employer seat and the
// tax rule set, but can never write payroll — every payroll circuit is gated on
// `employer`. Rotatable via `transferSeat(true, …)`.
export ledger platform: ZswapCoinPublicKey;


// taxTreasury: receive withheld taxes
export ledger taxTreasury: ZswapCoinPublicKey;
// socialTreasury: receive social contributions
export ledger socialTreasury: ZswapCoinPublicKey;

// The employer this instance belongs to. Meaningless until `employerAssigned`.
export ledger employer: ZswapCoinPublicKey;
export ledger employerAssigned: Boolean;

// Who this contract belongs to, remembered ACROSS a revoke.
//
// `revokeEmployer` clears `employer`, so the ledger stops claiming an ownership
// that no longer holds but that leaves `assignEmployer` with nothing to check
// a new name against, and a vacated seat could go to any key the platform
// picked. That is a write-access problem: `endEmployment` is write-once per
// slot, so a stranger in the seat could permanently burn a termination the real
// employee still needs.
//
// `everAssigned` is separate rather than derived: comparing `lastEmployer`
// against the zero key would conflate "never assigned" with "assigned to the
// zero key", and the zero key is what `revokeEmployer` writes.
export ledger lastEmployer: ZswapCoinPublicKey;
export ledger everAssigned: Boolean;

// Every period filed on this contract, and the most recent one.
// The period is YYYYMM as a number — 202603.
export ledger periods: Set<Uint<32>>;
export ledger latestPeriod: Uint<32>;

// How many employees were on the roster for a period. period → count.
// Always 2 in this build (see the roster note at the top).
export ledger employeeCountFor: Map<Uint<32>, Uint<8>>;

// The four column totals for a period. 
// Public together on purpose: the identity gross = tax + social + net is
// checked in-circuit per employee, so anyone can verify at the aggregate level
// that the withholding adds up — across every employer — without a single
// individual figure being readable.
//
// ⚠️ Only with a large enough roster. At 2, each employee knows their own
// figures, so subtracting them from a total gives the colleague's exactly.
export ledger totalPayrollFor: Map<Uint<32>, Uint<64>>;
export ledger totalTaxFor: Map<Uint<32>, Uint<64>>;
export ledger totalSocialFor: Map<Uint<32>, Uint<64>>;
export ledger totalNetFor: Map<Uint<32>, Uint<64>>;

// paramsHashFor: 
// key = Uint<32> = the period, YYYYMM (202603)
// value = Bytes<32> = the hash of the tax rule set for that period
export ledger paramsHashFor: Map<Uint<32>, Bytes<32>>;

// commitmentsFor: period (YYYYMM) → employee slot (0 or 1) → commitment to that
// employee's whole payslip line. The hash of a `PayrollCommitment`.
export ledger commitmentsFor: Map<Uint<32>, Map<Uint<8>, Bytes<32>>>;



// sealedFor: period → employee slot → the commitment's opening, encrypted to
// the employer's key. 100 bytes of AES-256-GCM (see `setPayroll`).
//
// Backup, not enforcement. The contract stores the blob and never checks it.
// A commitment nobody can open proves nothing, and the openings used to live
// only in a JSON file on the employer's laptop.
export ledger sealedFor: Map<Uint<32>, Map<Uint<8>, Bytes<100>>>;

// payeeFor: period → employee slot → hash binding the recipient to this slot.
// The hash of a `PayeeBinding` — see the struct above for what it hides.
//
// A hash, not the key: a public map of the keys on this payroll would publish
// the employment relationships everything else here exists to hide. The
// contract only needs to CHECK a recipient, never name one.
//
// ⚠️ Hashing the key alone was not enough. H(key) is the same value in every
// period of every instance, so one hash matched a person across all their
// employers at once — and equal hashes announce "same person" without anyone
// needing the key at all.
export ledger payeeFor: Map<Uint<32>, Map<Uint<8>, Bytes<32>>>;

// fundedFor / paidFor: period → employee slot → whether that slot has been
// funded, and whether it has been paid.
//
// Two steps because payroll is: a month is filed and funded when it's run, paid
// on payday. Per slot, so a dashboard can say "1 of 2 funded".
//
// `paidFor` is also the double-pay guard — without it a replayed call would
// send a second coin against the same commitment.
export ledger fundedFor: Map<Uint<32>, Map<Uint<8>, Boolean>>;
export ledger paidFor: Map<Uint<32>, Map<Uint<8>, Boolean>>;

// terminationFor: period → employee slot → hash of the employer's statement
// that employment ended. A `Termination`: see the struct above.
//
// A commitment, not the facts: `monthsWorked` published per slot would be a
// public tenure record for that worker. The opening goes to the fund's relay
// off chain, the same way a payslip goes to the employee.
//
// The employer cannot revise the statement afterwards and cannot spend it either: claiming needs the payee's own key,
// which `payeeFor` binds and this contract never holds.
export ledger terminationFor: Map<Uint<32>, Map<Uint<8>, Bytes<32>>>;

// fileRoundFor: period → how many times that period has been filed.
//
// Re-filing a month means a correction is being made. But coin
// nonces are DERIVED from the employer's passphrase, so a second round for the
// same period would rebuild an identical coin (same nonce, value and
// recipient), and Zswap rejects the duplicate commitment as `240
// CommitmentAlreadyPresent`.
//
// Feeding this counter into the derivation makes each round's coins distinct
// while keeping them reconstructible, which random nonces would not.
export ledger fileRoundFor: Map<Uint<32>, Uint<32>>;

// employerFor: period → the employer key that FILED it.
//
// `PayrollCommitment` binds `employer`, so reproducing a commitment needs the
// key that filed the period and the `employer` field is not that key. It's
// whoever holds the seat right now, and it moves: `revokeEmployer` zeroes it,
// `transferSeat` replaces it.
//
// ⚠️ Circuits used to read the moving value, which made two ordinary acts
// destructive: a revoke zeroed it and every issued payslip stopped verifying
// (reported as a mismatch, the message that means fraud), and a key rotation
// left unpaid periods unpayable because `payEmployee` could no longer reproduce
// the commitment it must open.
//
// A period's employer is a fact about the period, like its rule set. Re-filing
// a month overwrites this along with the commitments, which is right: the round
// that stands is the one whose figures stand.
export ledger employerFor: Map<Uint<32>, ZswapCoinPublicKey>;

// coinsReceived: how many coins this contract has ever received. 
export ledger coinsReceived: Uint<32>;

// coinOrdinalFor: period → employee slot → which coin funds that slot.
//
// A shielded coin has to be identified individually to be spent, so paying a
// slot means knowing exactly which of this contract's coins funded it. Recorded
// at funding time (the value of `coinsReceived` at that moment) and looked up
// when paying.
//
// ⚠️ Do not try to find it by listing coins instead. `filter(address)` returns
// every coin ever received, spent ones included, so counting positions picks an
// already-spent coin from an earlier period, which fails as `239
// NullifierAlreadyPresent` or `Public transcript input mismatch`.
export ledger coinOrdinalFor: Map<Uint<32>, Map<Uint<8>, Uint<32>>>;

// payToken: the token this instance pays in, frozen at deploy. Every coin in or
// out is checked against it, so a slot can't be funded or settled with a token
// minted for the purpose.
//
// ⚠️ It used to be fixed by the FIRST COIN RECEIVED. Funding is employer-only,
// so that let the employer pick any token — a self-minted one included — and
// still have every slot marked funded and paid and the tax marked remitted.
// Setting it at deploy takes that choice away, the same fix `taxvault.compact`
// made. The price is a deploy-order dependency: the token must exist before
// the payroll.
export ledger payToken: Bytes<32>;

// Withheld tax and social contributions, in minor units. Running totals for
// this contract, not per period — the per-period figures are `totalTaxFor` and
// `totalSocialFor`.
//
// The pools are balances: `fundWithholding` adds, `remit` subtracts.
// `taxRemitted` and `socialRemitted` only ever grow. So for every funded
// period, sum(totalTaxFor) == taxPool + taxRemitted, which is what makes the
// published figures checkable.
//
// Tax is kept here rather than forwarded per employee: one remittance a month
// instead of N, and the money stays under the contract's own accounting
// throughout.
export ledger taxPool: Uint<64>;
export ledger socialPool: Uint<64>;
export ledger taxRemitted: Uint<64>;
export ledger socialRemitted: Uint<64>;

// withheldFor: period → whether this period's withholding has been funded into
// the pools. Set by `fundWithholding`, and what `remit` checks before sending.
export ledger withheldFor: Map<Uint<32>, Boolean>;

// taxCoinFor / socialCoinFor: period → which of this contract's coins holds
// that period's tax, and which holds its social contribution.
// Same reason as `coinOrdinalFor`: remitting has to find the coin, not guess.
export ledger taxCoinFor: Map<Uint<32>, Uint<32>>;
export ledger socialCoinFor: Map<Uint<32>, Uint<32>>;


// Constructor: Deploys the instance. The deployer becomes the `platform` key, and the two
// treasury addresses are frozen here — `remit` can never send anywhere else.
// The platform key can be rotated later with `transferSeat(true, …)`; the
// treasuries and the pay token can never be changed.
constructor(taxTo: ZswapCoinPublicKey, socialTo: ZswapCoinPublicKey, pays: Bytes<32>) {
  platform = disclose(ownPublicKey());
  employerAssigned = false;
  everAssigned = false;
  latestPeriod = 0;
  payToken = disclose(pays);
  coinsReceived = 0;

  taxTreasury = disclose(taxTo);
  socialTreasury = disclose(socialTo);
  taxPool = 0;
  socialPool = 0;
  taxRemitted = 0;
  socialRemitted = 0;
}

// setParamsFor: Records which published rule set a period must be filed under.
//
// Platform-only, write-once per period: changing it after a filing would
// retroactively alter what the employer already committed to.
//
// Takes a month RANGE, not one month. A tax schedule is annual and every month
// of a year carries the identical hash, so `(2026, 1, 12)` records the whole
// year in one transaction instead of twelve. It's a range on this circuit
// rather than a separate one because a thirteenth verifier key pushed the
// deploy over the block limit.
//
// Months already recorded are skipped, not rejected — that's what makes
// re-running a year safe.
export circuit setParamsFor(
  year: Uint<16>,
  fromMonth: Uint<8>,
  months: Uint<8>,
  hash: Bytes<32>
): [] {
  assert(ownPublicKey() == platform, "only the platform may set the rule set");

  const y = disclose(year);
  assert(y >= 2000, "year must be YYYY, e.g. 2026");
  assert(y <= 2999, "year must be YYYY, e.g. 2026");

  const first = disclose(fromMonth);
  const count = disclose(months);
  assert(first >= 1, "the first month must be 1-12");
  assert(first <= 12, "the first month must be 1-12");
  assert(count >= 1, "must record at least one month");
  // An upper bound on the last month rather than on the count, so a range can
  // never roll past December into a month 13 — a key no period can ever equal,
  // and therefore a rule set nothing could ever be filed under.
  assert((first as Uint<16>) + (count as Uint<16>) <= 13, "the range runs past December");

  const h = disclose(hash);
  // Arithmetic widens the type; the bounds above keep every key inside
  // Uint<32>, and the casts are what tell the compiler so.
  const base = ((y as Uint<32>) * 100 + (first as Uint<32>)) as Uint<32>;
  for (const i of 0..12) {
    if ((i as Uint<8>) < count) {
      const p = (base + (i as Uint<32>)) as Uint<32>;
      if (!paramsHashFor.member(p)) {
        paramsHashFor.insert(p, h);
      }
    }
  }
}

// assignEmployer: hands the instance to an employer. Platform only, and only
// while the seat is vacant — at deploy, or after `revokeEmployer`.
//
// A revoked employer can be given the same instance back, and that is the ONLY
// thing a re-assignment can do: the assert against `lastEmployer` refuses any
// other key. One contract, one employer, for the life of the contract.
//
// A paid-up subscription should restore the employer to the contract holding
// their own payroll history. Handing that contract to somebody else is a
// different act, and this circuit can no longer be used for it.
//
// Cost: contracts can't be recycled. Onboarding deploys one per employer rather
// than revoking and reassigning a shared instance.
export circuit assignEmployer(newEmployer: ZswapCoinPublicKey): [] {
  assert(ownPublicKey() == platform, "only the platform may assign the employer");
  assert(!employerAssigned, "employer already assigned");
  assert(
    !everAssigned || newEmployer == lastEmployer,
    "this contract belongs to another employer"
  );

  employer = disclose(newEmployer);
  employerAssigned = true;
  lastEmployer = disclose(newEmployer);
  everAssigned = true;
}

// revokeEmployer: takes the seat back. Platform only.
//
// ⚠️ A real reduction in what an employer is guaranteed. Before this circuit
// existed, `assignEmployer` fired once and the platform had no privileged
// circuit left. Now the platform can vacate the seat at any time.
//
// What it cannot do is hand the seat onward — `assignEmployer` accepts only the
// key that held it, so the instance and its payroll history stay theirs and the
// only way back in is their own key.
//
// It writes no payroll and erases no history. Every employer-gated circuit
// asserts `employerAssigned`, which this clears, so a revoke locks those
// circuits rather than opening them to the platform. Commitments, terminations,
// pools and totals all stand.
//
// Money in flight is frozen, not lost: funded-but-unpaid slots become payable
// again when the same employer is re-seated. The pools are already empty: the
// assert below requires them settled before the seat is vacated, and `remit`
// itself needs a seated employer.
export circuit revokeEmployer(): [] {
  assert(ownPublicKey() == platform, "only the platform may revoke the employer");
  assert(employerAssigned, "no employer assigned yet");

  // Settle the pools before vacating. This is a proxy for "no month is
  // mid-flight", not an exact check: on the normal path `fundPeriod` funds net
  // coins and withholding together, so a non-zero pool means a month is in
  // progress. A period funded with `fundEmployee` alone slips through.
  //
  // The proxy is deliberate. A non-zero pool is cleared by `remit`, which the
  // platform can call itself — so this delays a revoke by one transaction the
  // platform can always make. An exact funded-unpaid counter would be cleared
  // only by `payPeriod`, which is employer-only, handing the employer a veto
  // over their own revocation.
  assert(
    taxPool == 0 && socialPool == 0,
    "remit this contract's withheld tax and contribution before revoking"
  );

  // Cleared rather than left stale: `employerAssigned` already gates everything,
  // but this is a public field and shouldn't state an ownership that ended.
  employer = default<ZswapCoinPublicKey>;
  employerAssigned = false;
}

// transferSeat: hands a seat to a new key. Only the current holder can do it.
//
// Two seats, one circuit. `transferSeat(true, k)` moves the platform seat —
// platform only. `transferSeat(false, k)` moves the employer seat — employer
// only.
//
// Why: keys get lost. A lost employer key means nobody can file payroll here
// again. A lost platform key is worse — only the platform can record a rule set
// (`setParamsFor`), and no period can be filed without one.
//
// Moving the platform seat does NOT grant payroll access: every payroll circuit
// checks `employer`, which the platform branch never touches.
//
// ⚠️ The employer branch accepts ANY key, so an employer can also hand their
// instance to a different party entirely. The platform cannot prevent it, only
// revoke afterwards.
//
// This was first written as two circuits, `transferPlatform` and
// `transferEmployer`. That deploy was refused: every circuit ships a verifier
// key of ~1,800 bytes in the deploy transaction, the contract was already near
// Midnight's per-transaction ceiling at twelve circuits, and a thirteenth went
// over. Merging them costs ~150 bytes of extra logic and saves a whole verifier
// key.
//
// `assignEmployer` and `revokeEmployer` are not folded in as well: they have
// different access rules, and merging those is how authorisation bugs happen.
export circuit transferSeat(isPlatform: Boolean, newHolder: ZswapCoinPublicKey): [] {
  const pf = disclose(isPlatform);

  // Without this, an unassigned `employer` is the zero key and the comparison
  // below would be a seat anyone could claim to hold.
  assert(pf || employerAssigned, "no employer assigned yet");

  const holder = pf ? platform : employer;
  assert(ownPublicKey() == holder, "only the holder of that seat may transfer it");

  const k = disclose(newHolder);
  if (pf) {
    platform = k;
  } else {
    employer = k;
    // The memory follows the seat. Otherwise `assignEmployer` would still be
    // holding the employer to the key this call just replaced, and a rotation
    // would quietly cost them the right to be restored after a revoke.
    lastEmployer = k;
  }
}

// FILE MONTH
// The month's FILING STEP. The employer submits everyone's gross salary, 
// the circuit computes what each person owes in tax and contributions, 
// and it writes commitments plus public totals. No money moves.
export circuit setPayroll(
  period: Uint<32>,
  gross: Vector<2, Uint<60>>,
  weeks: Vector<2, Uint<8>>,
  // The floor-division quotients. Compact has no `/`, so the caller supplies
  // each result and the circuit pins it: q * 10000 <= n < (q + 1) * 10000
  // admits exactly one q. Supplying them is not a licence to choose them.
  taxQ: Vector<2, Uint<60>>,
  socialQ: Vector<2, Uint<60>>,
  nonces: Vector<2, Bytes<32>>,
  sealedOpenings: Vector<2, Bytes<100>>,
  payees: Vector<2, Bytes<32>>,
  params: TaxParams
): [] {
  assert(employerAssigned, "no employer assigned yet");
  assert(ownPublicKey() == employer, "only the employer may set payroll");

  const p = disclose(period);

  // Rejected rather than silently accepted: a zero or absurd period would be a
  // typo, and a typo here writes a month of payroll where nobody will look for
  // it. The bound is deliberately loose — this checks shape, not calendar.
  assert(p >= 200001, "period must be YYYYMM, e.g. 202603");
  assert(p <= 299912, "period must be YYYYMM, e.g. 202603");

  // The rule set. Recorded by the platform for this period, so the employer
  // cannot pick a cheaper published version.
  assert(paramsHashFor.member(p), "no rule set recorded for that period");
  assert(
    paramsHashFor.lookup(p) == persistentHash<TaxParams>(params),
    "these are not the rules recorded for that period"
  );
  assert(disclose(params.validFrom) <= p, "that rule set does not apply yet");

  const t1 = params.threshold1;
  const t2 = params.threshold2;
  const maxBase = params.maxContribBase;

  // Calculate employee 0's taxes and contributions 
  const g0 = gross[0];
  const a1 = g0 < t1 ? g0 : t1;
  const a2 = g0 <= t1 ? 0 : ((g0 < t2 ? g0 : t2) - t1) as Uint<60>;
  const a3 = g0 <= t2 ? 0 : (g0 - t2) as Uint<60>;
  const taxN0 =
    (a1 as Uint<80>) * (params.rate1 as Uint<80>) +
    (a2 as Uint<80>) * (params.rate2 as Uint<80>) +
    (a3 as Uint<80>) * (params.rate3 as Uint<80>);
  assert((taxQ[0] as Uint<80>) * 10000 <= taxN0, "tax quotient too small");
  assert(taxN0 < ((taxQ[0] as Uint<80>) + 1) * 10000, "tax quotient too large");

  const base0 = g0 < maxBase ? g0 : maxBase;
  const socN0 = (base0 as Uint<80>) * (params.contribRate as Uint<80>);
  assert((socialQ[0] as Uint<80>) * 10000 <= socN0, "contribution quotient too small");
  assert(socN0 < ((socialQ[0] as Uint<80>) + 1) * 10000, "contribution quotient too large");

  assert(taxQ[0] + socialQ[0] <= g0, "tax and contribution exceed gross");
  const net0 = (g0 - taxQ[0] - socialQ[0]) as Uint<60>;

  // Calculate employee 1's taxes and contributions 
  const g1 = gross[1];
  const c1 = g1 < t1 ? g1 : t1;
  const c2 = g1 <= t1 ? 0 : ((g1 < t2 ? g1 : t2) - t1) as Uint<60>;
  const c3 = g1 <= t2 ? 0 : (g1 - t2) as Uint<60>;
  const taxN1 =
    (c1 as Uint<80>) * (params.rate1 as Uint<80>) +
    (c2 as Uint<80>) * (params.rate2 as Uint<80>) +
    (c3 as Uint<80>) * (params.rate3 as Uint<80>);
  assert((taxQ[1] as Uint<80>) * 10000 <= taxN1, "tax quotient too small");
  assert(taxN1 < ((taxQ[1] as Uint<80>) + 1) * 10000, "tax quotient too large");

  const base1 = g1 < maxBase ? g1 : maxBase;
  const socN1 = (base1 as Uint<80>) * (params.contribRate as Uint<80>);
  assert((socialQ[1] as Uint<80>) * 10000 <= socN1, "contribution quotient too small");
  assert(socN1 < ((socialQ[1] as Uint<80>) + 1) * 10000, "contribution quotient too large");

  assert(taxQ[1] + socialQ[1] <= g1, "tax and contribution exceed gross");
  const net1 = (g1 - taxQ[1] - socialQ[1]) as Uint<60>;

  // Each public total is the SUM OF THE PER-EMPLOYEE FIGURES, never a rate
  // reapplied to the gross total. Floor division does not distribute, and the
  // brackets are progressive, so taxing the sum gives a materially different number. 
  // The commitments hold the per-employee amounts, so these totals are what the pools must match.
  const grossTotal = g0 + g1;
  const taxTotal = taxQ[0] + taxQ[1];
  const socialTotal = socialQ[0] + socialQ[1];
  const netTotal = net0 + net1;
  // Back into vectors so the loop below stays a loop.
  const net = [net0, net1];

  // A period can be re-filed — corrections happen — but not once money is
  // sitting against it.
  //
  // Re-filing resets `fundedFor` to false while the coin stays in the contract.
  // Funding again receives a SECOND coin and overwrites `coinOrdinalFor`, so
  // the first becomes unreachable by any circuit here: not just unaccounted,
  // unspendable. Hence slots must be paid (or never funded) first.
  //
  // The withholding has no way through at all, so it's refused outright.
  // `withheldFor` is never reset, and re-filing moves `totalTaxFor`:
  //   • before remitting — `taxCoinFor` names a coin holding the OLD amount and
  //     `remit` asserts against the NEW total, so it can never pass. Re-funding
  //     is blocked too, since `withheldFor` is already true.
  //   • after remitting — the corrected month's withholding can never be
  //     funded, and the chain shows tax that was never collected.
  //
  // The rule: a month can be corrected until money moves against it, not after.
  assert(
    !withheldFor.member(p) || !withheldFor.lookup(p),
    "this period's withholding is funded — a funded month cannot be re-filed"
  );

  if (fundedFor.member(p)) {
    for (const i of 0..2) {
      const idx = i as Uint<8>;
      if (fundedFor.lookup(p).member(idx)) {
        if (fundedFor.lookup(p).lookup(idx)) {
          assert(
            paidFor.lookup(p).member(idx) && paidFor.lookup(p).lookup(idx),
            "this period has funded slots that are not paid — settle them before re-filing"
          );
        }
      }
    }
  }

  // These six are Map<period, Map<slot, …>>. The loop below writes into the
  // inner map, so it has to exist first, created on a first filing, and the
  // `if` makes each a no-op on a re-file.
  if (!commitmentsFor.member(p)) {
    commitmentsFor.insert(p, default<Map<Uint<8>, Bytes<32>>>);
  }
  if (!sealedFor.member(p)) {
    sealedFor.insert(p, default<Map<Uint<8>, Bytes<100>>>);
  }
  if (!payeeFor.member(p)) {
    payeeFor.insert(p, default<Map<Uint<8>, Bytes<32>>>);
  }
  if (!paidFor.member(p)) {
    paidFor.insert(p, default<Map<Uint<8>, Boolean>>);
  }
  if (!fundedFor.member(p)) {
    fundedFor.insert(p, default<Map<Uint<8>, Boolean>>);
  }
  if (!coinOrdinalFor.member(p)) {
    coinOrdinalFor.insert(p, default<Map<Uint<8>, Uint<32>>>);
  }

  // Cleared, not preserved — the ONE map a re-file resets.
  //
  // A slot is an index, not a person. `payeeFor` is rewritten below, so slot 0
  // after a re-file need not be the same employee as before. A termination left
  // in place would follow the index and silently attach to whoever now occupies
  // it: an attestation the employer never made about that person.
  //
  // In practice this clears an empty map. `endEmployment` needs the month's
  // withholding FUNDED, and the guard above refuses to re-file a month whose
  // withholding is funded — so a month carrying a termination can't reach this
  // line. The reset stays so that invariant doesn't rest on one assert in
  // another circuit.
  //
  // It used to be a real hole: `endEmployment` required only the slot PAID, so
  // a month settled through `fundEmployee` + `payEmployee` without
  // `fundWithholding` could carry a termination and still be re-filed, wiping
  // the attestation.
  terminationFor.insert(p, default<Map<Uint<8>, Bytes<32>>>);

  // Every filing starts a new round, so a re-filed month funds fresh coins.
  if (!fileRoundFor.member(p)) {
    fileRoundFor.insert(p, 0);
  } else {
    fileRoundFor.insert(p, (fileRoundFor.lookup(p) + 1) as Uint<32>);
  }

  // Recorded BEFORE the commitments below, and read back by everything that
  // reopens them. `employer` and `employerFor.lookup(p)` are the same value in
  // this circuit and only in this circuit — which is the whole reason the write
  // belongs here rather than anywhere else.
  employerFor.insert(p, employer);

  for (const i of 0..2) {
    commitmentsFor.lookup(p).insert(
      i as Uint<8>,
      disclose(persistentHash<PayrollCommitment>(
        PayrollCommitment {
          gross: gross[i],
          tax: taxQ[i],
          social: socialQ[i],
          net: net[i],
          weeks: weeks[i],
          period: p,
          employer: employerFor.lookup(p),
          paramsHash: paramsHashFor.lookup(p),
          nonce: nonces[i]
        }
      ))
    );
    // Written in the same circuit as the commitment it opens, so a period can
    // never end up on chain with one and not the other.
    sealedFor.lookup(p).insert(i as Uint<8>, disclose(sealedOpenings[i]));
    payeeFor.lookup(p).insert(i as Uint<8>, disclose(payees[i]));
    // Re-filing a period resets its payment flags along with its commitments:
    // a corrected month has not been paid, even if the month it replaced was.
    paidFor.lookup(p).insert(i as Uint<8>, false);
    fundedFor.lookup(p).insert(i as Uint<8>, false);
  }

  periods.insert(p);
  totalPayrollFor.insert(p, disclose(grossTotal));
  totalTaxFor.insert(p, disclose(taxTotal));
  totalSocialFor.insert(p, disclose(socialTotal));
  totalNetFor.insert(p, disclose(netTotal));
  employeeCountFor.insert(p, 2);

  // Only ever moves forward, so a correction filed for an old month does not
  // make that month look like the current one.
  if (p > latestPeriod) {
    latestPeriod = p;
  }
}


// FUND EMPLOYEE: Moves one employee's salary into the contract, ahead of payday.
// fundEmployee funds one slot's net pay. 
// fundPeriod below funds the whole month, so both employees' in one transaction.
// fundPeriod is the normal path, and the reason is atomicity
// fundEmployee is the recovery path: a run that broke partway, or funding one slot at a time for a reason.
//
// The amount is checked against the commitment on the way in, not just on the
// way out. Funding a slot with the wrong figure would otherwise sit undetected
// until `payEmployee` refused it, after a proof per slot and a month of
// assuming the payroll was covered.
//
// One coin per slot rather than one pot for the period. Two reasons, neither of
// them privacy: a single pot has to be split on every payment, so payouts
// serialise and two of them race; and a per-slot coin already carries exactly
// the committed amount, so `payEmployee` moves it whole.
export circuit fundEmployee(
  period: Uint<32>,
  index: Uint<8>,
  gross: Uint<60>,
  tax: Uint<60>,
  social: Uint<60>,
  net: Uint<60>,
  weeks: Uint<8>,
  nonce: Bytes<32>,
  coin: ShieldedCoinInfo
): [] {
  assert(employerAssigned, "no employer assigned yet");
  assert(ownPublicKey() == employer, "only the employer may fund payroll");

  const p = disclose(period);
  const i = disclose(index);

  assert(commitmentsFor.member(p), "no payroll filed for that period");
  assert(commitmentsFor.lookup(p).member(i), "no such employee in that period");
  assert(!fundedFor.lookup(p).lookup(i), "already funded");

  assert(
    commitmentsFor.lookup(p).lookup(i) ==
      persistentHash<PayrollCommitment>(
PayrollCommitment {
          gross: gross, tax: tax, social: social, net: net,
          weeks: weeks, period: p, employer: employerFor.lookup(p),
          paramsHash: paramsHashFor.lookup(p), nonce: nonce
        }
      ),
    "the figures and nonce do not open the commitment for that employee"
  );

  assert(payToken == disclose(coin.color), "wrong token for this payroll");
  // Net, not gross: this coin is the employee's. Tax and the contribution are
  // funded once for the whole period by `fundWithholding`, because they are
  // owed to two destinations rather than to N people.
  assert(coin.value == net as Uint<128>, "coin does not hold the committed net pay");

  receiveShielded(disclose(coin));
  fundedFor.lookup(p).insert(i, true);

  // Which receipt number this coin is, so paying doesn't have to guess. NOT a
  // leaf position — see the `coinOrdinalFor` declaration.
  coinOrdinalFor.lookup(p).insert(i, coinsReceived);
  coinsReceived = (coinsReceived + 1) as Uint<32>;
}

// FUND PERIOD: funds the whole month in one transaction, so both employees' net
// pay, plus the tax and social contribution.
//
// The normal path. Run separately, `fundEmployee` and `fundWithholding` leave a
// window where employees are funded and the withholding isn't (`fundedFor`
// true, `withheldFor` false): a state in which the employer is holding money
// that isn't theirs. Here it can't occur: one circuit receives every coin or
// none. On this path, skipping the tax stops being something to notice and
// chase, and becomes something that can't be built.
//
// ⚠️ On this path only. `fundEmployee` + `payEmployee` still settle a month
// without `fundWithholding` ever being called. What they can't do is carry a
// termination: `endEmployment` requires the withholding funded.
//
// One circuit, not several calls in one transaction. A call's transcript is
// computed against the state BEFORE the transaction, so two calls can't see
// each other's writes — `coinsReceived` is incremented by every receipt here
// and read back for the next. That would be wrong across separate calls and the
// ledger would reject the replay.
//
// It does not pay anyone. Spending a coin needs its position in the Zswap tree,
// which doesn't exist until the coin has been committed — so receiving and
// spending can't share a transaction, and `payPeriod` stays separate.
export circuit fundPeriod(
  period: Uint<32>,
  gross: Vector<2, Uint<60>>,
  tax: Vector<2, Uint<60>>,
  social: Vector<2, Uint<60>>,
  net: Vector<2, Uint<60>>,
  weeks: Vector<2, Uint<8>>,
  nonces: Vector<2, Bytes<32>>,
  netCoins: Vector<2, ShieldedCoinInfo>,
  taxCoin: ShieldedCoinInfo,
  socialCoin: ShieldedCoinInfo
): [] {
  assert(employerAssigned, "no employer assigned yet");
  assert(ownPublicKey() == employer, "only the employer may fund payroll");

  const p = disclose(period);
  assert(commitmentsFor.member(p), "no payroll filed for that period");
  assert(!withheldFor.member(p) || !withheldFor.lookup(p), "withholding already funded");

  // ── the roster, unrolled ────────────────────────────────────────────────
  for (const i of 0..2) {
    const idx = i as Uint<8>;
    assert(commitmentsFor.lookup(p).member(idx), "no such employee in that period");
    assert(!fundedFor.lookup(p).lookup(idx), "already funded");

    assert(
      commitmentsFor.lookup(p).lookup(idx) ==
        persistentHash<PayrollCommitment>(
          PayrollCommitment {
            gross: gross[i], tax: tax[i], social: social[i], net: net[i],
            weeks: weeks[i], period: p, employer: employerFor.lookup(p),
            paramsHash: paramsHashFor.lookup(p), nonce: nonces[i]
          }
        ),
      "the figures and nonce do not open the commitment for that employee"
    );

    assert(payToken == disclose(netCoins[i].color), "wrong token for this payroll");
    // Net, not gross. This coin is the employee's; the withholding is received
    // below, once for the period, because it is owed to two destinations rather
    // than to N people.
    assert(netCoins[i].value == net[i] as Uint<128>, "coin does not hold the committed net pay");

    receiveShielded(disclose(netCoins[i]));
    fundedFor.lookup(p).insert(idx, true);
    coinOrdinalFor.lookup(p).insert(idx, coinsReceived);
    coinsReceived = (coinsReceived + 1) as Uint<32>;
  }

  // ── the withholding ─────────────────────────────────────────────────────
  //
  // Checked against the period totals, which `setPayroll` accumulated from the
  // per-employee figures rather than by reapplying a rate to the gross total.
  // Checking against them is therefore checking against the commitments opened
  // above.
  assert(payToken == disclose(taxCoin.color), "wrong token for the tax coin");
  assert(payToken == disclose(socialCoin.color), "wrong token for the contribution coin");
  assert(
    taxCoin.value == totalTaxFor.lookup(p) as Uint<128>,
    "tax coin does not hold the tax assessed for that period"
  );
  assert(
    socialCoin.value == totalSocialFor.lookup(p) as Uint<128>,
    "contribution coin does not hold the contribution assessed for that period"
  );

  receiveShielded(disclose(taxCoin));
  taxCoinFor.insert(p, coinsReceived);
  coinsReceived = (coinsReceived + 1) as Uint<32>;

  receiveShielded(disclose(socialCoin));
  socialCoinFor.insert(p, coinsReceived);
  coinsReceived = (coinsReceived + 1) as Uint<32>;

  taxPool = (taxPool + totalTaxFor.lookup(p)) as Uint<64>;
  socialPool = (socialPool + totalSocialFor.lookup(p)) as Uint<64>;
  withheldFor.insert(p, true);
}

// Pays one employee the exact amount committed for them.
//
// This is the circuit the whole design exists for. The commitment already on
// chain is the payment authorisation: the caller must produce a (salary, nonce)
// that hashes to it, and the coin that moves is required to carry exactly that
// salary. Nobody, including the employer, can pay an employee an amount that
// differs from what was committed for them, and no observer learns what any of
// those amounts are.
//
// The coin is a witness rather than ledger state, deliberately. A contract that
// stores its own `QualifiedShieldedCoinInfo` publishes the value in cleartext,
// which would hand every salary to anyone reading the chain. Keeping it as an
// argument means the caller must reconstruct the coin from the indexer, which
// is a real cost, paid on purpose.
export circuit payEmployee(
  period: Uint<32>,
  index: Uint<8>,
  gross: Uint<60>,
  tax: Uint<60>,
  social: Uint<60>,
  net: Uint<60>,
  weeks: Uint<8>,
  nonce: Bytes<32>,
  coin: QualifiedShieldedCoinInfo,
  payee: ZswapCoinPublicKey
): [] {
  assert(employerAssigned, "no employer assigned yet");
  assert(ownPublicKey() == employer, "only the employer may pay");

  const p = disclose(period);
  const i = disclose(index);

  assert(commitmentsFor.member(p), "no payroll filed for that period");
  assert(commitmentsFor.lookup(p).member(i), "no such employee in that period");
  assert(fundedFor.lookup(p).lookup(i), "that slot has not been funded");
  assert(!paidFor.lookup(p).lookup(i), "already paid");

  // The opening must reproduce the commitment. This is what stops an employer
  // paying a different figure than the one they published a commitment to.
  assert(
    commitmentsFor.lookup(p).lookup(i) ==
      persistentHash<PayrollCommitment>(
PayrollCommitment {
          gross: gross, tax: tax, social: social, net: net,
          weeks: weeks, period: p, employer: employerFor.lookup(p),
          paramsHash: paramsHashFor.lookup(p), nonce: nonce
        }
      ),
    "the figures and nonce do not open the commitment for that employee"
  );

  // And it must go to the person that slot was filed for, so marking a slot
  // paid cannot be done by sending the money somewhere else.
  assert(
    payeeFor.lookup(p).lookup(i) ==
      persistentHash<PayeeBinding>(
        PayeeBinding { payee: payee, period: p, instance: kernel.self().bytes }
      ),
    "recipient is not the payee filed for that employee"
  );

  // One token per instance, frozen at deploy, so a slot can't be settled with a
  // token minted for the purpose.
  assert(payToken == disclose(coin.color), "wrong token for this payroll");

  // The coin must carry exactly the committed salary — not at least it, not a
  // convenient round number. Sending less than the coin holds would leave the
  // remainder stranded in the contract with nothing recording that it exists.
  assert(coin.value == net as Uint<128>, "coin does not hold the committed net pay");

  sendShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(payee)),
    disclose(net) as Uint<128>
  );

  paidFor.lookup(p).insert(i, true);
}

// endEmployment: Records that an employee's employment ended, as of a filed period.
//
// Write-once per slot: a termination that could be reissued would let an
// employer restate the final month after seeing what it entitled someone to,
// and the whole point of attesting on chain is that the statement is fixed
// before anyone acts on it.
//
// The one release is a re-file, which clears this period's terminations along
// with its commitments, see the note at that line in `setPayroll` for why it
// must (a slot is an index, and a re-file can change who occupies it). That is
// not a way around write-once: this circuit requires the month's withholding
// funded, and `setPayroll` refuses to re-file any period whose withholding is
// funded, so once a termination exists its month can't be re-filed and the
// statement can't be restated by any route.
export circuit endEmployment(
  period: Uint<32>,
  index: Uint<8>,
  attestation: Bytes<32>
): [] {
  assert(employerAssigned, "no employer assigned yet");
  assert(ownPublicKey() == employer, "only the employer may end employment");

  const p = disclose(period);
  const i = disclose(index);

  assert(commitmentsFor.member(p), "no payroll filed for that period");
  assert(commitmentsFor.lookup(p).member(i), "no such employee in that period");

  // The final month must have been PAID, not merely filed. A month can sit
  // filed and never funded, and a termination naming such a month attests that
  // employment ended in a period where no money moved. So anything built on it
  // downstream rests on figures the employer published and never honoured.
  //
  // `paidFor.lookup(p)` is safe unguarded: `setPayroll` writes a flag for every
  // index in the same circuit that writes the commitment checked above.
  //
  // ⚠️ The cost falls on the EMPLOYEE. An employer who never pays the final
  // month — or pays it but never funds its withholding (see below) — can't
  // attest its termination. So a worker whose employer stopped paying can't get
  // the statement a claim is built from, exactly when they most need it. The contract can't tell a delinquent employer from a slow
  // one. The softer form is `fundedFor` instead of `paidFor`: money reached the
  // contract, without requiring it reached the employee.
  assert(
    paidFor.lookup(p).lookup(i),
    "that slot has not been paid — a termination must name a settled period"
  );
  // And the month's withholding funded. Without this, a month settled through
  // `fundEmployee` + `payEmployee` alone could carry a termination whose tax
  // never arrived — and since only funded withholding blocks a re-file, that
  // termination could then be wiped and restated by re-filing the month.
  assert(
    withheldFor.member(p) && withheldFor.lookup(p),
    "that period's withholding is not funded — a termination must name a settled period"
  );

  if (!terminationFor.member(p)) {
    terminationFor.insert(p, default<Map<Uint<8>, Bytes<32>>>);
  }
  assert(
    !terminationFor.lookup(p).member(i),
    "employment has already been ended for that employee"
  );
  terminationFor.lookup(p).insert(i, disclose(attestation));
}

// Fundwithholding: the employer sends two coins (tax and social) into the contract. 
// The circuit checks each equals the period's assessed total, receives them, adds to taxPool/socialPool, 
// and sets withheldFor[p] = true. Money is now held by the contract.
//
// One call for the period rather than one per employee: tax is owed to a
// treasury, not to N people, and the amounts are already the SUM of the
// committed per-employee figures.
//
// The money stays here afterwards. Forwarding it per period would cost a
// transaction each time and put it at an address before anyone has committed to
// what it is; held in the pool it is under this contract's own accounting until
// `remit` sends it on.
export circuit fundWithholding(
  period: Uint<32>,
  taxCoin: ShieldedCoinInfo,
  socialCoin: ShieldedCoinInfo
): [] {
  assert(employerAssigned, "no employer assigned yet");
  assert(ownPublicKey() == employer, "only the employer may fund withholding");

  const p = disclose(period);
  assert(commitmentsFor.member(p), "no payroll filed for that period");
  assert(!withheldFor.member(p) || !withheldFor.lookup(p), "already funded");

  assert(payToken == disclose(taxCoin.color), "wrong token for the tax coin");
  assert(payToken == disclose(socialCoin.color), "wrong token for the contribution coin");

  assert(
    taxCoin.value == totalTaxFor.lookup(p) as Uint<128>,
    "tax coin does not hold the tax assessed for that period"
  );
  assert(
    socialCoin.value == totalSocialFor.lookup(p) as Uint<128>,
    "contribution coin does not hold the contribution assessed for that period"
  );

  receiveShielded(disclose(taxCoin));
  taxCoinFor.insert(p, coinsReceived);
  coinsReceived = (coinsReceived + 1) as Uint<32>;

  receiveShielded(disclose(socialCoin));
  socialCoinFor.insert(p, coinsReceived);
  coinsReceived = (coinsReceived + 1) as Uint<32>;

  taxPool = (taxPool + totalTaxFor.lookup(p)) as Uint<64>;
  socialPool = (socialPool + totalSocialFor.lookup(p)) as Uint<64>;
  withheldFor.insert(p, true);
}

// REMIT: sends one period's withheld tax OR social contribution out to its
// treasury. `isTax` picks which, so a fully remitted month takes two calls.
//
// One circuit for both because they were the same circuit twice — identical
// guards, checks and send, differing only in six paired fields. A payroll
// deploy sits on the network's per-transaction ceiling and thirteen circuits
// was one too many. Numbers in `docs/findings.md`.
//
// ⚠️ There is exactly ONE `sendShielded`, and `treasury` reaches it as a
// disclosed ARGUMENT. Reading the recipient from the ledger and sending to it
// directly got every remittance refused by the node with a bare 103; passing it
// as an argument — the way `payPeriod` passes `disclose(payees[i])` — fixed it.
// Do not move the send inside the branch, and do not read `taxTreasury`
// directly: both put that fix back at risk.
//
// ⚠️ Ledger provenance may not be the whole cause: the fund's former
// `remitBenefitTax` sent to `taxTreasury` read from its ledger and landed
// (tx 43f90e25…), and the fund's `claim` still sends to ledger-read treasuries. This shape
// is kept because it is the one proven HERE, not because the cause is settled.
//
// Taking the treasury as an argument does not let a caller choose it. The
// assert below pins it to the value frozen at deploy and refuses any other.
export circuit remit(
  period: Uint<32>,
  isTax: Boolean,
  treasury: ZswapCoinPublicKey,
  coin: QualifiedShieldedCoinInfo
): [] {
  assert(employerAssigned, "no employer assigned yet");
  // Safe to allow two callers only because of the `treasury` assert below: the
  // platform can trigger a spend, and the worst it can do is pay the employer's
  // own frozen treasury early. If the destination ever becomes choosable, this
  // must narrow to the employer in the same change.
  assert(
    ownPublicKey() == employer || ownPublicKey() == platform,
    "only the employer or the platform may remit"
  );

  const p = disclose(period);
  const t = disclose(isTax);
  assert(withheldFor.member(p) && withheldFor.lookup(p), "that period is not funded");
  assert(
    t ? taxCoinFor.member(p) : socialCoinFor.member(p),
    "no coin recorded for that period"
  );

  const owed = t ? totalTaxFor.lookup(p) : totalSocialFor.lookup(p);
  const frozen = t ? taxTreasury : socialTreasury;

  assert(payToken == disclose(coin.color), "wrong token for this payroll");
  assert(coin.value == owed as Uint<128>, "coin does not hold that period's amount");
  assert(disclose(treasury) == frozen, "that is not this contract's treasury for that");

  sendShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(treasury)),
    disclose(owed) as Uint<128>
  );

  if (t) {
    taxPool = (taxPool - owed) as Uint<64>;
    taxRemitted = (taxRemitted + owed) as Uint<64>;
    taxCoinFor.remove(p);
  } else {
    socialPool = (socialPool - owed) as Uint<64>;
    socialRemitted = (socialRemitted + owed) as Uint<64>;
    socialCoinFor.remove(p);
  }
}

// PAY PERIOD: pays every slot in one transaction. `payEmployee` pays one — use
// that for a run that broke partway.
// NOTE AGAIN: payPeriod pays both slots in one transaction; payEmployee pays one 
//
// Separate payments fail partway through with node error 170,
// `InvalidDustSpendProof` — the FEE proof going stale across rapid
// transactions, not anything about the contract's own coins. One transaction
// needs one dust spend proof instead of N, which fixes it (verified at ten
// employees, 90 seconds of proving).
//
// Batching also removes a leak, independently of the bug, and the same one that
// makes `setPayroll` a single call: one payment per slot publishes one event
// per slot, showing which settled when. One transaction settles the month with
// no per-employee signal.
//
// All-or-nothing is a feature: a half-paid month is a worse state than a month
// that failed cleanly and can be retried.
export circuit payPeriod(
  period: Uint<32>,
  gross: Vector<2, Uint<60>>,
  tax: Vector<2, Uint<60>>,
  social: Vector<2, Uint<60>>,
  net: Vector<2, Uint<60>>,
  weeks: Vector<2, Uint<8>>,
  nonces: Vector<2, Bytes<32>>,
  coins: Vector<2, QualifiedShieldedCoinInfo>,
  payees: Vector<2, ZswapCoinPublicKey>
): [] {
  assert(employerAssigned, "no employer assigned yet");
  assert(ownPublicKey() == employer, "only the employer may pay");

  const p = disclose(period);
  assert(commitmentsFor.member(p), "no payroll filed for that period");

  for (const i of 0..2) {
    const idx = i as Uint<8>;

    assert(fundedFor.lookup(p).lookup(idx), "a slot has not been funded");
    assert(!paidFor.lookup(p).lookup(idx), "a slot has already been paid");

    assert(
      commitmentsFor.lookup(p).lookup(idx) ==
        persistentHash<PayrollCommitment>(
          PayrollCommitment {
            gross: gross[i], tax: tax[i], social: social[i], net: net[i],
            weeks: weeks[i], period: p, employer: employerFor.lookup(p),
            paramsHash: paramsHashFor.lookup(p), nonce: nonces[i]
          }
        ),
      "the figures and nonce do not open the commitment for that employee"
    );
    assert(
      payeeFor.lookup(p).lookup(idx) ==
        persistentHash<PayeeBinding>(
          PayeeBinding { payee: payees[i], period: p, instance: kernel.self().bytes }
        ),
      "recipient is not the payee filed for that employee"
    );
    assert(payToken == disclose(coins[i].color), "wrong token for this payroll");
    assert(
      coins[i].value == net[i] as Uint<128>,
      "coin does not hold the committed net pay"
    );

    sendShielded(
      disclose(coins[i]),
      left<ZswapCoinPublicKey, ContractAddress>(disclose(payees[i])),
      disclose(net[i]) as Uint<128>
    );
    paidFor.lookup(p).insert(idx, true);
  }
}

// The three bracket bands for one gross salary, exposed so the client's copy of
// this arithmetic can be tested against the real one.
//
// There are necessarily two implementations: Compact has no division, so
// `setPayroll` cannot derive the tax itself. The caller computes it and the
// circuit pins the quotient. That makes the TypeScript version load-bearing
// rather than decorative, and two implementations of one calculation that must
// agree exactly is the kind of thing that passes every demo and fails on the
// one salary sitting exactly on a threshold.
//
// The division half is safe by construction: the circuit checks
// q * 10000 <= n < (q + 1) * 10000, which admits one q, and BigInt `/` is floor
// division, so both land on it whenever the numerator agrees. The exposure is
// here, in the boundary branches — hence a circuit whose output a test can
// compare against, rather than a reading of the source everyone hopes is right.
export pure circuit bandsFor(
  gross: Uint<60>,
  threshold1: Uint<60>,
  threshold2: Uint<60>
): Vector<3, Uint<60>> {
  const b1 = gross < threshold1 ? gross : threshold1;
  const b2 = gross <= threshold1
    ? 0
    : ((gross < threshold2 ? gross : threshold2) - threshold1) as Uint<60>;
  const b3 = gross <= threshold2 ? 0 : (gross - threshold2) as Uint<60>;
  return [b1, b2, b3];
}

// Pure, so the employer's client builds an attestation with the contract's own
// hash rather than a TypeScript reimplementation that could drift from Compact's
// struct encoding — the same reason `commitmentFor` exists.
export pure circuit terminationCommitment(
  finalPeriod: Uint<32>,
  monthsWorked: Uint<16>,
  nonce: Bytes<32>
): Bytes<32> {
  return persistentHash<Termination>(
    Termination {
      finalPeriod: finalPeriod,
      monthsWorked: monthsWorked,
      nonce: nonce
    }
  );
}

// Pure, for the same reason `commitmentFor` is: the employer needs to compute
// the payee hash locally when filing, and it must be the identical hash this
// contract checks against — not a re-implementation in TypeScript that could
// drift from the struct encoding Compact uses.
export pure circuit payeeHash(
  payee: ZswapCoinPublicKey,
  period: Uint<32>,
  instance: Bytes<32>
): Bytes<32> {
  return persistentHash<PayeeBinding>(
    PayeeBinding { payee: payee, period: period, instance: instance }
  );
}

// Pure: touches no ledger state, so the compiler exposes it in `pureCircuits`
// and it can be evaluated locally with no transaction. That gives the employer
// a way to recompute a commitment from (salary, nonce) and check it against
// what is on chain — using exactly the hash the circuit used.
export pure circuit commitmentFor(
  gross: Uint<60>,
  tax: Uint<60>,
  social: Uint<60>,
  net: Uint<60>,
  weeks: Uint<8>,
  period: Uint<32>,
  employer: ZswapCoinPublicKey,
  paramsHash: Bytes<32>,
  nonce: Bytes<32>
): Bytes<32> {
  return persistentHash<PayrollCommitment>(
    PayrollCommitment {
      gross: gross, tax: tax, social: social, net: net,
      weeks: weeks, period: period, employer: employer,
      paramsHash: paramsHash, nonce: nonce
    }
  );
}
