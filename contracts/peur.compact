pragma language_version >= 0.16;

import CompactStandardLibrary;

// pEUR — the stablecoin payroll is paid in.
//
// Shielded, so amounts are private on chain. That is the whole point: a payroll
// contract that hides salaries is pointless if paying them publishes the same
// numbers as transfers.
//
// The token type is derived from this contract's own address, so it is unique
// to this deployment and cannot be forged by another contract:
//   tokenType(pad(32, "pEUR"), kernel.self())
//
// Minting is issuer-only and always pays the issuer. Keeping the recipient as
// the caller avoids a key exchange entirely: a shielded coin can only be found
// and spent by someone whose encryption key the transaction was built with, and
// the issuer's own wallet already has it. Paying anyone else requires their coin
// public key AND encryption public key.

// The deployer. Only this key may mint.
export ledger issuer: ZswapCoinPublicKey;

// This deployment's token type, recorded on the first mint. Zero until then.
export ledger tokenId: Bytes<32>;

// Public: how much pEUR exists. Individual holdings stay private — supply
// transparency is what makes a stablecoin auditable against its reserves.
export ledger totalSupply: Uint<64>;

// Makes each mint's coin nonce unique. Two mints of equal value would otherwise
// produce identical coins.
export ledger mintCounter: Counter;

// Amounts are minor units (cents), capped at Uint<48> — about 2.8 trillion EUR —
// so accumulating into the Uint<64> supply cannot overflow in practice.
// The initial supply is NOT minted here. A deploy transaction cannot carry the
// mint: the contract's address is not fixed until the transaction is built, so
// `kernel.self()` in a constructor does not yet name this deployment — the mint
// fails to balance, and a token type derived here comes out wrong. `npm run
// deploy:peur` therefore deploys and then immediately mints, in two
// transactions but one command.
constructor() {
  issuer = disclose(ownPublicKey());
  totalSupply = 0;
}

// Issues pEUR straight to someone else — an employer being funded, say.
//
// The recipient is a coin public key, but that alone is not enough for them to
// use the coin: a shielded coin can only be found and spent by someone whose
// encryption key the transaction was built with. The caller must therefore also
// supply the recipient's encryption public key off-circuit, via the SDK's
// `additionalCoinEncPublicKeyMappings`. Get both from `npm run frontend` or the
// recipient's `npm run peur`.
export circuit mintTo(amount: Uint<48>, recipient: ZswapCoinPublicKey): [] {
  assert(ownPublicKey() == issuer, "only the issuer may mint pEUR");

  tokenId = tokenType(pad(32, "pEUR"), kernel.self());

  const next = totalSupply + disclose(amount);
  assert(next <= 18446744073709551615, "pEUR supply would overflow");
  totalSupply = next as Uint<64>;

  mintCounter.increment(1);
  mintShieldedToken(
    pad(32, "pEUR"),
    disclose(amount),
    evolveNonce(mintCounter, kernel.self().bytes),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient))
  );
}

// Tops up supply later. Same issuer check, same self-recipient.
export circuit mint(amount: Uint<48>): [] {
  assert(ownPublicKey() == issuer, "only the issuer may mint pEUR");

  // Recorded here rather than in the constructor, where `kernel.self()` would
  // not yet resolve to this deployment. Rewriting it every mint is idempotent.
  tokenId = tokenType(pad(32, "pEUR"), kernel.self());

  const next = totalSupply + disclose(amount);
  assert(next <= 18446744073709551615, "pEUR supply would overflow");
  totalSupply = next as Uint<64>;

  mintCounter.increment(1);
  mintShieldedToken(
    pad(32, "pEUR"),
    disclose(amount),
    evolveNonce(mintCounter, kernel.self().bytes),
    left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey())
  );
}
