pragma language_version >= 0.16;

import CompactStandardLibrary;

// pEUR — the stablecoin payroll is paid in.
//
// Shielded, so amounts are private on chain. That is the whole point: a payroll
// contract that hides salaries is pointless if paying them publishes the same
// numbers as transfers.
//
//
// ⚠️  DEMO TOKEN. Anyone may mint, in any amount, without permission. That makes
// pEUR worthless as a store of value and it is meant to: this exists so a demo
// can hand out payroll funds without a faucet queue or an operator in the loop.
// A real stablecoin's whole claim is that supply is controlled and auditable
// against reserves, which is exactly the property given up here. 
//
// `mint` pays the caller, which avoids a key exchange entirely: a shielded coin
// can only be found and spent by someone whose encryption key the transaction
// was built with, and the caller's own wallet already has it. Paying anyone else
// needs their coin public key AND encryption public key, which is `mintTo`.

// The deployer. Provenance ONLY — it gates nothing. Everyone can mint freely for this demo
export ledger issuer: ZswapCoinPublicKey;

// This deployment's token type, recorded on the first mint. Zero until then.
export ledger tokenId: Bytes<32>;

// Public: how much pEUR exists. Individual holdings stay private
export ledger totalSupply: Uint<64>;


// Counts how many times pEUR has been minted, and gives each new coin a
// different nonce.
//
// Every shielded coin needs a unique nonce, or two mints of the same amount
// would create two identical coins. `evolveNonce` takes this counter and the
// contract address and produces one. Both mint circuits bump it, so no two
// mints anywhere in this contract can clash.
//
// Like all ledger state in Midnight, this is public. That's fine here: the
// mint amounts are public too (see `totalSupply`), so the counter doesn't
// reveal anything new.
export ledger mintCounter: Counter;


// pEUR has 6 decimals: 1 pEUR = 1_000_000. So `mint(5_000_000)` mints
// 5 pEUR. 

// Constructor: 
// Issuer is the deployer (public) but anyone can mint in this demo 
// No minting of initial supply at deployment
constructor() {
  issuer = disclose(ownPublicKey());
  totalSupply = 0;
}

// export circuit — makes it a callable entry point. An exported circuit gets its own verifier key, 
// lands in the generated TypeScript as a callable, and can be invoked in a transaction. 
// A circuit without export is internal 
// All ledger state in Midnight is public on chain, exported or not


// Function 1 mintTo: Mints pEUR to someone else — an employer being funded, say.
//
// The recipient's coin public key isn't enough on its own: a shielded coin can
// only be spent by someone whose encryption key the transaction was built with.
// The caller must also pass the recipient's encryption public key off-circuit,
// via the SDK's `additionalCoinEncPublicKeyMappings`. Both come from
// `npm run frontend` or the recipient's `npm run peur`.
export circuit mintTo(amount: Uint<48>, recipient: ZswapCoinPublicKey): [] {
  // The token type, derived from this contract's address so it's unique to this
  // deployment. Set here rather than in the constructor, where the address
  // isn't known yet. Rewriting it every mint is harmless.
  tokenId = tokenType(pad(32, "pEUR"), kernel.self());

  // Compact widens the sum instead of wrapping it, so `next` holds the true
  // total even if it doesn't fit in 64 bits. This catches that case with a
  // readable error. (The `as Uint<64>` cast below would also catch it, but the
  // message is a cryptic compiler one.)
  const next = totalSupply + disclose(amount);
  assert(next <= 18446744073709551615, "pEUR supply would overflow");
  totalSupply = next as Uint<64>;

  // The counter makes each coin's nonce unique — see `mintCounter` above.
  mintCounter.increment(1);
  mintShieldedToken(
    pad(32, "pEUR"),                                    // token name
    disclose(amount),                                   // published on chain
    evolveNonce(mintCounter, kernel.self().bytes),      // unique per mint
    left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient))  // pay a user, not a contract
  );
}

// Function 2 mint: Mints pEUR to the caller. Open to anyone — see the demo warning at the top.
// No key exchange needed, unlike `mintTo`: a shielded coin can only be spent by
// someone whose encryption key the transaction was built with, and the caller's
// own wallet already has it.
export circuit mint(amount: Uint<48>): [] {
  // The token type, derived from this contract's address so it's unique to this
  // deployment. Set here rather than in the constructor, where the address
  // isn't known yet. Rewriting it every mint is harmless — and measurably
  // cheaper than branching to skip the write.
  tokenId = tokenType(pad(32, "pEUR"), kernel.self());

  // Compact widens the sum instead of wrapping it, so `next` holds the true
  // total even if it doesn't fit in 64 bits. This catches that case with a
  // readable error. (The `as Uint<64>` cast below would also catch it, but the
  // message is a cryptic compiler one.)
  const next = totalSupply + disclose(amount);
  assert(next <= 18446744073709551615, "pEUR supply would overflow");
  totalSupply = next as Uint<64>;

  // The counter makes each coin's nonce unique — see `mintCounter` above.
  mintCounter.increment(1);
  mintShieldedToken(
    pad(32, "pEUR"),                                // token name
    disclose(amount),                               // published on chain
    evolveNonce(mintCounter, kernel.self().bytes),  // unique per mint
    left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey())  // pay the caller
  );
}