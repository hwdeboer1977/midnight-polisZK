pragma language_version >= 0.16;

import CompactStandardLibrary;

// The rule sets payroll is computed under, versioned and immutable.
//
// One instance, shared by every employer. It holds no money and has exactly one
// job: to be the record of what the tax rates were, so that a period filed in
// August 2026 stays checkable against August 2026's rules forever. A payroll
// whose rules can be rewritten afterwards proves nothing, and every claim
// derived from it becomes unprovable the moment the rates change.
//
// ── Append-only, and that is the whole safety property ────────────────────
// A version is written once and can never be edited or replaced. 
// The cost is that a mistake is permanent. It is corrected the way a mistake in
// a published statute is corrected: by publishing a later version that
// supersedes it, not by altering the record.

// The tax rules used to compute net pay from gross. Stored on chain and public:
// everyone must be able to check that a payslip used the real rates, even
// though the salary itself stays private.
struct TaxParams {
  // Which rule set this is. The on-chain map is keyed by this number.
  version: Uint<16>;
  // The month this version starts applying, as YYYYMM (e.g. 202601 = Jan 2026).
  // Kept as a field, not the key, so a correction can replace an earlier
  // version for the same month.
  validFrom: Uint<32>;

  // Income tax: three brackets, so two thresholds between them.
  // Monthly amounts, in minor units (1 EUR = 1_000_000).
  threshold1: Uint<60>;
  threshold2: Uint<60>;
  // Rates in basis points: 3705 = 37.05%.
  rate1: Uint<16>;  // on income up to threshold1
  rate2: Uint<16>;  // on the part between threshold1 and threshold2
  rate3: Uint<16>;  // on everything above threshold2

  // Social contributions: one flat rate, charged on gross only up to a ceiling.
  maxContribBase: Uint<60>;  // income above this is not charged
  contribRate: Uint<16>;     // also basis points
}

// Who is allowed to publish a tax rule set.
// In production this would be a public body or a threshold key: whoever sets
// tax rates isn't whoever runs a payroll platform. 
export ledger authority: ZswapCoinPublicKey;

// The registry: version number -> its rule set.
// Written once per version and never overwritten, so a published rule set can't
// change under a payslip that already used it.
export ledger paramsFor: Map<Uint<16>, TaxParams>;

// Every version number ever published. `paramsFor` can only be read if you
// already know which version to ask for; this lets anyone list them all and
// audit the registry from scratch.
export ledger versions: Set<Uint<16>>;

// Highest version published so far, and how many there are. Both public — the
// whole registry is meant to be checkable by anyone.
export ledger latestVersion: Uint<16>;
export ledger versionCount: Uint<16>;

// Sets the authority to whoever deploys. disclose() = publish a private value
// on purpose. No rule sets exist yet; publish them after deployment.
constructor() {
  authority = disclose(ownPublicKey());
  latestVersion = 0;
  versionCount = 0;
}


// Hands the authority seat to a new key.
//
// This is the most important key in the codebase. Payroll can't file a period
// without a rule set published here, so if this key is lost and can't be
// rotated, no new period can be filed on ANY payroll instance once the calendar
// moves past the last published version — the whole platform, not one contract.
// (Compare `taxvault.transferAuthority`, which protects a balance, and
// `payroll.transferSeat`, which protects one instance.)
//
// Rotation grants nothing new: the holder could already publish any rule set,
// and publication is append-only, so a new authority cannot alter or withdraw
// anything already published.
export circuit transferAuthority(newAuthority: ZswapCoinPublicKey): [] {
  assert(ownPublicKey() == authority, "only the authority may transfer the seat");

  authority = disclose(newAuthority);
}

// Publishes a rule set. Once — a version can never be changed after this.
//
// Everything here is public, and has to be: nobody can recheck a payroll's
// published totals without knowing the rates it claims to have used.
export circuit publish(params: TaxParams): [] {
  assert(ownPublicKey() == authority, "only the authority may publish rules");

  const v = disclose(params.version);
  assert(v > 0, "version must be greater than zero");
  assert(!paramsFor.member(v), "that version is already published and cannot be changed");

  const startsAt = disclose(params.validFrom);
  assert(startsAt >= 200001, "validFrom must be YYYYMM, e.g. 202601");
  assert(startsAt <= 299912, "validFrom must be YYYYMM, e.g. 202601");

  // Checked here so the payroll circuit doesn't have to.
  assert(
    disclose(params.threshold1) < disclose(params.threshold2),
    "thresholds must be in ascending order"
  );

  // ── Tax plus contributions must not exceed gross pay ────────────────────
  //
  // Checked at publication, not at payroll, because a bad rule set is
  // unfixable: a period can only ever be pointed at one version, so a version
  // whose rates can't produce a valid filing bricks every period using it.
  //
  // Simplified tax system for DEMO: 
  // Payroll asserts per employee that taxQ + socialQ <= gross — you can't deduct more than someone earns.
  // max(rate1, rate2, rate3) + contribRate ≤ 10000
  // Not restrictive in practice: the Dutch schedule's worst case is rate3 4950
  // plus contribRate 300, or 52.5%.
  const r12 = params.rate1 > params.rate2 ? params.rate1 : params.rate2;
  const rateMax = r12 > params.rate3 ? r12 : params.rate3;
  assert(
    (disclose(rateMax) as Uint<32>) + (disclose(params.contribRate) as Uint<32>) <= 10000,
    "the worst marginal rate plus the contribution rate must not exceed 10000 basis points"
  );

  // ⚠️ Deliberately NOT checked:
  //
  //   · Rates need not increase across brackets. Real schedules aren't always
  //     progressive — the Dutch one has a bracket where the marginal rate falls
  //     once credits are included. Requiring it would bake one country's shape
  //     into a registry meant to outlive it.
  //   · `maxContribBase` has no upper limit. Setting it above any real salary
  //     makes contributions effectively uncapped — a policy choice, and a
  //     visible one.
  //   · `versionCount` overflows at 65,536 versions. Compact range-checks the
  //     cast, so it would refuse the publish rather than wrap (see findings.md).

  paramsFor.insert(v, disclose(params));
  versions.insert(v);
  versionCount = (versionCount + 1) as Uint<16>;
  // Guarded, so publishing an out-of-order correction doesn't move the pointer
  // backwards.
  if (v > latestVersion) {
    latestVersion = v;
  }
}

// Computes the hash a payroll contract records for a period.
//
// `pure` means it reads no ledger state and touches nothing — the employer, the
// platform and any reviewer all feed in the same published fields and get the
// same 32 bytes back.
//
// Why a hash and not a version number: contracts on Midnight can't read each
// other's state, so a payroll or claim circuit has no way to look up
// `paramsFor[v]` here. Passing the params in and hashing them lets it prove
// exactly which rules produced an attestation, without needing this registry at
// all.
export pure circuit paramsHash(params: TaxParams): Bytes<32> {
  return persistentHash<TaxParams>(params);
}