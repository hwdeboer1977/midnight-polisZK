pragma language_version >= 0.16;

import CompactStandardLibrary;

// Contract B in the claimContractCall runtime test: the one that refuses to act
// unless another contract's call is present in the same transaction.
//
// This is the tax contract's shape, reduced to nothing else. In the real design
// it would also check a coin against figures inside the claimed commitment; here
// it only claims, because the question is whether claiming is ENFORCED. Adding
// money would give a second reason for the node to refuse and make a rejection
// mean nothing.
//
// ── The two runs that matter ───────────────────────────────────────────────
//
// POSITIVE: bundle `atomic.bump` and this call, with the commitment actually
// produced by that bump. Expect: lands.
//
// NEGATIVE: submit this call ALONE, naming a commitment for a call that is not
// in the transaction. Expect: refused.
//
// The negative is the whole test. If a lone claim lands, `claimContractCall`
// records an assertion nobody checks, and option D is dead however well it
// compiles — the tax contract would be enforcing nothing.

// How many claims this contract has accepted.
export ledger claims: Uint<32>;

// The last commitment claimed. Stored so the positive and negative runs can be
// told apart from state alone, and so a verifier could later compare what was
// claimed against what the other contract actually recorded.
export ledger lastComm: Field;

// Which address and entry point were named. Public on purpose: the whole value
// of the claim is that a third party can check it against the other contract.
export ledger lastAddress: Bytes<32>;
export ledger lastEntry: Bytes<32>;

constructor() {
  claims = 0;
  lastComm = 0;
}

export circuit claimIt(addr: Bytes<32>, entry: Bytes<32>, comm: Field): [] {
  // The line under test. Everything after it is bookkeeping so the result is
  // visible on chain.
  kernel.claimContractCall(disclose(addr), disclose(entry), disclose(comm));

  claims = (claims + 1) as Uint<32>;
  lastComm = disclose(comm);
  lastAddress = disclose(addr);
  lastEntry = disclose(entry);
}
