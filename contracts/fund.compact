pragma language_version >= 0.16;

import CompactStandardLibrary;

// The unemployment fund.
//
// A claimant proves two things and discloses neither: that she was employed for
// long enough, and what her final salary was. The benefit derives from that
// salary. Nobody is recorded as unemployed anywhere: there is no claimant
// list, no status field, and nothing an observer can enumerate to find one.
//
// Why this is a separate contract, and what that costs. A payroll contract
// cannot call this one and this one cannot read a payroll ledger: both were
// probed and both are walls (see probe/probe_xcall.compact, probe_xread.compact).
// So the fund cannot look up the commitment it needs to check a claim against.
// It has to be told, by a relay, and that relay is trusted to be faithful. What
// is ENFORCED here is that the claimant knows an opening matching something the
// fund was told; that the thing it was told is a true copy of payroll state is
// publicly verifiable by anyone with an indexer, and not enforced. Stating that
// the other way round would be a lie about what a proof proves.

// The anonymity set is what makes a claim safe to make, so it is worth being
// explicit about its shape. Anchors are published as ONE Merkle root per
// period, over every accredited employer on the platform. So not per employer,
// and not per employee. A claim discloses the final period its attestation
// names, the calendar month being claimed and the nullifier, and nothing else,
// so a claimant is indistinguishable from everyone terminated in the same month
// anywhere on the platform. A root per employer would undo that by making the
// disclosed root name the employer.
//
//
// This is also why membership is proved with a path rather than a map lookup.
// A `Map` lookup takes a public key, and every candidate key here is
// enumerable from public payroll state — instance, period and slot are all
// published — so a lookup would announce exactly which slot of which employer
// the claim was for. The path is a witness; only the root and the period are
// public.
//
// ── No public amounts ──────────────────────────────────────────────────────
// The tax and contribution withheld from a benefit leave INSIDE the claim, as
// shielded coins straight to the two treasuries. They used to accumulate in
// public pools and be remitted later, and because every claim is its own
// transaction, each claim moved those pools by exactly its own withholding —
// which inverts to the benefit and, below the cap, to the final gross. Nothing
// public moves by an amount now. See `claim` for what that costs.

// Struct BenefitParams: the benefit rules a claim is computed under. Published
// by the platform, versioned, and hashed into `paramsFor`; the platform then
// records which version applies to each final period in `paramsHashFor`.
struct BenefitParams {
  version: Uint<16>;
  // The first final period this version may be recorded for, as YYYYMM.
  // Checked by `setParamsFor`, so a period can't be pointed at rules that
  // didn't exist yet.
  validFrom: Uint<32>;
  // The cap on the monthly gross the benefit is computed from. Dutch Unemployment Benefit (UB) caps a
  // daily wage; this caps its monthly equivalent, and the figure is a policy
  // input that must be sourced rather than chosen here.
  maxMonthlyGross: Uint<60>;
  // Basis points of the capped gross. Dutch UB steps this down after the opening
  // months, which this version does not model — see the honesty note on `claim`.
  rate: Uint<16>;
  // Months of employment required. Twelve, under the rules this models.
  minMonths: Uint<16>;
  // How many calendar months after the final period can be claimed: a duration
  // of three admits the three months following the final period, and nothing
  // else.
  //
  // Here rather than as a circuit constant because it's a policy figure like
  // the rest: published, versioned, changed by publishing a new version.
  durationMonths: Uint<16>;
}

// Struct ClaimLeaf: what a claimant proves membership of.
//
// One leaf per terminated employee, built by the relay from public payroll
// state plus the employer's termination attestation. Every field is a witness
// at claim time: the leaf hash is what enters the tree, so none of this is
// disclosed by proving membership.
struct ClaimLeaf {
  // That period's salary commitment, copied from `commitmentsFor[p][slot]`.
  // Copied rather than re-attested on purpose: an employer who wants to inflate
  // a final salary has to do it in the month itself, where it moves the
  // employer's own published `totalPayrollFor` and is assessed for tax and
  // contribution. The attack stays possible and stops being free.
  commitment: Bytes<32>;
  // `payeeFor[p][slot]`, which is what ties the leaf to a wallet without naming
  // one. Only the holder of that key can reproduce it.
  payeeBinding: Bytes<32>;
  // The employer's attestation, and the reason the claimant cannot shop for her
  // best month: the final period is named by the employer, and the commitment
  // in this leaf is that period's.
  finalPeriod: Uint<32>;
  // Checked against `minMonths`. Comes from the employer's attestation and is
  // not derived from the filed periods — nothing cross-checks the two.
  monthsWorked: Uint<16>;
  // The payroll instance, so a leaf cannot be replayed against another one.
  instance: Bytes<32>;
}


// ── Three structs copied verbatim from payroll.compact ─────────────────────
//
// Compact can't share a struct across contracts, and `persistentHash` encodes
// a struct field by field in declaration order. Payroll produced these hashes;
// the claim below recomputes them. So any difference — a field moved, a width
// changed, a field added — makes every claim fail to open, with no compile
// error and a message that reads like the claimant supplied wrong data.

// Struct TaxParams: declared identically to payroll.compact's.
//
// A claim proves `persistentHash<TaxParams>(taxParams)` equals the `paramsHash`
// bound into her salary commitment — a hash produced by payroll's encoding of
// ITS struct. So a field reordered or retyped here breaks every claim, with an
// error pointing at the tax rules rather than at this declaration.
//
// The fund cannot read the taxparams registry — no contract here can read
// another — so it has no independent source for a tax schedule. It doesn't need
// one: the schedule is pinned by a hash payroll already published and already
// bound into the commitment the claimant must open. The benefit is therefore
// taxed under provably the same rules her final salary was, without the fund
// reading the registry or trusting the claimant.
struct TaxParams {
  version: Uint<16>;
  validFrom: Uint<32>;
  threshold1: Uint<60>;
  threshold2: Uint<60>;
  rate1: Uint<16>;
  rate2: Uint<16>;
  rate3: Uint<16>;
  maxContribBase: Uint<60>;
  contribRate: Uint<16>;
}

// Declared identically to payroll.compact's, because the claim recomputes a
// commitment that payroll's circuit produced. A reordered or retyped field here
// stops every claim from opening, silently.
struct PayrollCommitment {
  gross: Uint<60>;
  tax: Uint<60>;
  social: Uint<60>;
  net: Uint<60>;
  weeks: Uint<8>;
  period: Uint<32>;
  employer: ZswapCoinPublicKey;
  paramsHash: Bytes<32>;
  nonce: Bytes<32>;
}

// Likewise.
struct PayeeBinding {
  payee: ZswapCoinPublicKey;
  period: Uint<32>;
  instance: Bytes<32>;
}


// Struct RootAuthorSlot: identifies one author's publication of one root.
// Hashed to key `rootAuthor`, so two authors publishing for the same period
// can't collide and neither can lock the other out.
struct RootAuthorSlot {
  author: ZswapCoinPublicKey;
  period: Uint<32>;
  root: Field;
}

// Struct ClaimNullifier: marks one calendar month as claimed by one wallet.
// Hashed, checked against `spent`, then inserted — so each (person, month) pays
// out once, and `fund` stops a nullifier being replayed against another
// deployment.
//
// Keyed on the MONTH, not on a window counted from the termination. That is
// what lets a later job loss be claimed at all — its months are new months —
// while two terminations that overlap can't pay the same month twice. A window
// index would get one of those wrong: per wallet it strands the second job
// loss, per termination it pays overlapping attestations twice.
//
// ⚠️ Keyed on her WALLET, and this is a deliberate trade. It used to key on a
// secret claim key, because hash(payee, month) is computable by anyone who has
// ever been given her coin public key — they can enumerate months, test the
// public `spent` set, and read her benefit history off it.
//
// That property cost a file. The claim key lived in one download, couldn't be
// sealed to her wallet (the connector exposes no decrypt) or derived from a
// signature (non-deterministic), and the employer had to collect its hash
// BEFORE a write-once attestation — so a wrong value stranded her permanently.
//
// What is NOT given up: only she can claim. `payeeBinding` binds the claim to
// `ownPublicKey()` independently. What is given up is unlinkability — anyone
// holding her payment address can tell THAT she claimed, and for which months,
// never how much.
//
// Restoring it without a file needs a secret her wallet can reproduce on
// demand. WebAuthn PRF is that shape; nothing in the connector is, today.
struct ClaimNullifier {
  payee: ZswapCoinPublicKey;
  month: Uint<32>;
  fund: Bytes<32>;
}

// Struct ClaimMonth: the calendar month being claimed, and the arithmetic that
// pins it. All of it is disclosed — the month is public anyway, since the
// block-time check publishes when it started.
//
// Compact has no division, so a YYYYMM number can't be split into year and
// month in-circuit, and a year can't be tested for leap-ness. The claimant
// supplies the pieces and `claim` / `monthStart` pin each one to the single
// value that fits.
struct ClaimMonth {
  // The final period split into year and month: finalYear * 100 + finalMonth
  // must equal `leaf.finalPeriod`, with finalMonth 1-12.
  finalYear: Uint<16>;
  finalMonth: Uint<8>;
  // The month being claimed.
  year: Uint<16>;
  month: Uint<8>;
  // floor(year / 4), floor(year / 100), floor(year / 400) — pinned in
  // `monthStart`, and what decides whether `year` is a leap year.
  q4: Uint<16>;
  q100: Uint<16>;
  q400: Uint<16>;
}

export ledger platform: ZswapCoinPublicKey;

// Where withholding on a benefit goes, frozen at deploy and never settable again.
// `claim` sends to these directly. Same two keys payroll uses: money withheld
// from a salary and money withheld from the benefit that replaces it land in
// the same place.
export ledger taxTreasury: ZswapCoinPublicKey;
export ledger socialTreasury: ZswapCoinPublicKey;

// paramsFor: version → persistentHash(BenefitParams). The hash only, not the
// struct — the platform supplies the params when recording them for a period,
// and `setParamsFor` checks them against this.
//
// Append-only, for the same reason the tax registry is: a benefit computed
// under rules that can be rewritten afterwards proves nothing about what
// anyone was entitled to.
export ledger paramsFor: Map<Uint<16>, Bytes<32>>;

// `latestVersion` is the pointer a client reads to find the current rules.
export ledger latestVersion: Uint<16>;

// paramsHashFor: final period (YYYYMM) → the hash of the benefit rules a
// termination in that month is claimed under. Platform-recorded, write-once,
// and only ever a version published in `paramsFor`.
//
// This is what stops a claimant choosing her rules. With only a version check,
// every published version with `validFrom` at or before her final period
// qualified — so an older one with a higher rate, a lower `minMonths` or a
// longer duration was hers to pick. Payroll pins its tax rules per period the
// same way, with `paramsHashFor`.
export ledger paramsHashFor: Map<Uint<32>, Bytes<32>>;

// rootFor: period (YYYYMM) → the Merkle root of that period's claim tree.
// One root per period over every accredited employer on the platform — that
// breadth is the anonymity set. A claim proves membership in this tree and
// discloses which final period (and which month it claims), so the claimant is
// indistinguishable from everyone terminated that month anywhere on the
// platform.
export ledger rootFor: Map<Uint<32>, Field>;

// rootAuthor: hash(author, period, root) → who published it.
// Publication is permissionless: a single privileged relay could block a claim
// by declining to publish, which looks the same as an outage. Forgery is
// unprevented either way, so opening the write costs nothing.
// Keyed per author so nobody can occupy a period's slot with garbage and lock
// others out.
export ledger rootAuthor: Map<Bytes<32>, ZswapCoinPublicKey>;

// Spent nullifiers. Public. Each is hash(wallet, month, fund), so anyone who
// holds a claimant's coin public key can find her entries here — see
// `ClaimNullifier` for why that trade was made.
export ledger spent: Set<Bytes<32>>;

// Public totals. Coarse by design — how many claims, never who or how much each.
export ledger claimsPaid: Counter;

// The token this fund holds and pays in, frozen at deploy.
//
// ⚠️ It used to be set by the FIRST COIN RECEIVED. `fundBenefits` is open to
// anyone, so anyone could send one unit of a token they minted themselves, pin
// the fund to it, and every real contribution afterwards would fail `wrong
// token for this fund` — permanently. The same attack `taxvault.compact`
// closed the same way. The price is a deploy-order dependency: the token must
// exist before the fund.
export ledger benefitToken: Bytes<32>;

// A receipt counter: every deposit, and each claim's surviving change coin, gets
// the next number. Spent coins keep their numbers. The two intermediate change
// coins a claim creates and spends in the same transaction get none.
export ledger coinsReceived: Uint<32>;

// Contributions coming IN, per period and in total.
//   contributedFor:         period (YYYYMM) → amount that arrived for it
//   contributionSourceFor:  period → which payroll contract it was said to
//                           come from (first depositor wins)
//   contributedTotal, contributionCount: running totals
//
// A contribution that lands with nothing saying what it was FOR can't be
// checked against anything. With these, a verifier compares `contributedFor[p]`
// against the payroll contract's `totalSocialFor[p]` and sees whether the right
// amount arrived.
//
// ⚠️ Claimed, not proved. This contract can't read a payroll ledger, so it
// records what a depositor states. The mismatch is publicly checkable, not
// enforced here.
//
// Money going OUT is deliberately not totalled: see the note on `claim`.
export ledger contributedFor: Map<Uint<32>, Uint<64>>;
export ledger contributionSourceFor: Map<Uint<32>, Bytes<32>>;
export ledger contributedTotal: Uint<64>;
export ledger contributionCount: Uint<32>;

// The receipt number of the coin that most recently entered the pool: a
// deposit, or the change a claim left behind. An ordinal — not a nonce, not a
// value, and not a Zswap leaf position (receipt order and tree order can
// differ). Enough for the fund's operator to reconstruct the coin they already
// know the value of, and useless to anyone who does not.
//
// It names the LATEST coin only. The fund holds one coin per deposit plus the
// change coins, and `claim` accepts any fund-owned coin of the right token, so
// an older coin is still spendable, just not pointed at here.
export ledger poolOrdinal: Uint<32>;

// Constructor: the deployer becomes the platform; the treasuries and the token
// are frozen here and can never be changed.
constructor(taxTo: ZswapCoinPublicKey, socialTo: ZswapCoinPublicKey, holds: Bytes<32>) {
  platform = disclose(ownPublicKey());
  latestVersion = 0;
  benefitToken = disclose(holds);
  contributedTotal = 0;
  contributionCount = 0;
  coinsReceived = 0;

  taxTreasury = disclose(taxTo);
  socialTreasury = disclose(socialTo);
}

// Publishes a rule set. Platform-only and write-once per version.
//
// Publishing makes a version AVAILABLE; it applies to nothing until
// `setParamsFor` records it for a period.
export circuit publishParams(params: BenefitParams): [] {
  assert(ownPublicKey() == platform, "only the platform may publish rules");
  const v = disclose(params.version);
  assert(v > 0, "version must be positive");
  assert(!paramsFor.member(v), "that version is already published");
  assert(disclose(params.rate) <= 10000, "rate cannot exceed 100%");
  assert(disclose(params.minMonths) > 0, "eligibility needs a minimum");
  assert(disclose(params.durationMonths) > 0, "an entitlement needs at least one month");

  paramsFor.insert(v, persistentHash<BenefitParams>(disclose(params)));
  if (v > latestVersion) {
    latestVersion = v;
  }
}

// setParamsFor: records which published rule set terminations in a range of
// final periods are claimed under. Platform-only, write-once per period.
//
// The same shape as `payroll.setParamsFor` — a year and a month range, so a
// whole year is one transaction — with one thing payroll can't do: the rules
// are checked against this contract's own registry. Payroll takes a hash on
// trust because the tax registry is another contract; here `paramsFor` is in
// the same ledger, so only a published version can be recorded.
//
// Months already recorded are skipped, not rejected, so re-running a year is
// safe and a recorded month can never be changed.
export circuit setParamsFor(
  year: Uint<16>,
  fromMonth: Uint<8>,
  months: Uint<8>,
  params: BenefitParams
): [] {
  assert(ownPublicKey() == platform, "only the platform may set the rule set");

  const v = disclose(params.version);
  assert(paramsFor.member(v), "no such rule set");
  const h = persistentHash<BenefitParams>(disclose(params));
  assert(paramsFor.lookup(v) == h, "those are not the published rules for that version");

  const y = disclose(year);
  assert(y >= 2000, "year must be YYYY, e.g. 2026");
  assert(y <= 2999, "year must be YYYY, e.g. 2026");

  const first = disclose(fromMonth);
  const count = disclose(months);
  assert(first >= 1, "the first month must be 1-12");
  assert(first <= 12, "the first month must be 1-12");
  assert(count >= 1, "must record at least one month");
  // An upper bound on the last month rather than on the count, so a range can
  // never roll past December into a month 13.
  assert((first as Uint<16>) + (count as Uint<16>) <= 13, "the range runs past December");

  const base = ((y as Uint<32>) * 100 + (first as Uint<32>)) as Uint<32>;
  assert(disclose(params.validFrom) <= base, "that rule set does not apply yet");

  for (const i of 0..12) {
    if ((i as Uint<8>) < count) {
      const p = (base + (i as Uint<32>)) as Uint<32>;
      if (!paramsHashFor.member(p)) {
        paramsHashFor.insert(p, h);
      }
    }
  }
}

// publishRoot: publishes one period's claim tree root.
//
// Open to anyone, but only the platform's root is the one `claim` checks
// against. Third-party publications are recorded in `rootAuthor` and are
// evidence, not an alternative: if the platform declines to publish, claims for
// that period still can't be made. What anyone else can do is publish the
// correct root and make the discrepancy visible.
//
// Widening this to accept another author is a policy change, not a contract
// change — the roots are all here and attributable.
export circuit publishRoot(period: Uint<32>, root: Field): [] {
  const p = disclose(period);
  assert(p >= 200001, "period must be YYYYMM");
  assert(p <= 299912, "period must be YYYYMM");

  const author = disclose(ownPublicKey());
  const slot = persistentHash<RootAuthorSlot>(
    RootAuthorSlot { author: author, period: p, root: disclose(root) }
  );
  assert(!rootAuthor.member(slot), "you have already published that root");
  rootAuthor.insert(slot, author);

  if (author == platform) {
    rootFor.insert(p, disclose(root));
  }
}

// fundBenefits: takes in money to pay benefits with, against the period it
// covers. Open to anyone.
//
// Contributions can't arrive automatically: a payroll contract can't call this
// one, so a remittance lands at a key and funding the fund is a deliberate
// transaction by whoever holds it.
//
// `period` and `source` are what make that transaction attributable. Without
// them a contribution is an unattributed increase in a pool, and "did
// September's contributions arrive" has no answer on chain. Same two fields as
// `taxvault.compact`, same reason.
//
// `amount` is stated alongside the coin and pinned to it rather than read off
// `coin.value`: coin values are Uint<128> and these totals are Uint<64>, and
// Compact won't narrow between them.
export circuit fundBenefits(
  period: Uint<32>,
  source: Bytes<32>,
  amount: Uint<64>,
  coin: ShieldedCoinInfo
): [] {
  const p = disclose(period);
  // Shape, not calendar — the same bound `setPayroll` applies.
  assert(p >= 200001, "period must be YYYYMM, e.g. 202609");
  assert(p <= 299912, "period must be YYYYMM, e.g. 202609");
  assert(disclose(amount) > 0, "a contribution of nothing records nothing");

  assert(benefitToken == disclose(coin.color), "wrong token for this fund");
  assert(coin.value == disclose(amount) as Uint<128>, "coin does not hold the stated amount");

  receiveShielded(disclose(coin));
  poolOrdinal = coinsReceived;
  coinsReceived = (coinsReceived + 1) as Uint<32>;

  // Accumulated, not overwritten: a period may be paid in instalments, or by
  // more than one payroll contract.
  const already = contributedFor.member(p) ? contributedFor.lookup(p) : 0;
  contributedFor.insert(p, (already + disclose(amount)) as Uint<64>);

  // First writer wins, so the field says where a period's money started
  // arriving from rather than pretending one field can name several.
  if (!contributionSourceFor.member(p)) {
    contributionSourceFor.insert(p, disclose(source));
  }

  contributedTotal = (contributedTotal + disclose(amount)) as Uint<64>;
  contributionCount = (contributionCount + 1) as Uint<32>;
}

// CLAIM: claims one calendar month's benefit.
//
// Discloses the final period, the month claimed, the nullifier, which rule set
// applies (its hash is recorded per period) and that a claim happened. Not the
// employer, not the slot, not the salary, not the benefit.
//
// Pays three shielded coins out of one fund coin: the net to the claimant, the
// withheld tax to `taxTreasury`, the withheld contribution to `socialTreasury`.
// The remainder comes back to the fund as change.
//
// ⚠️ What sending the withholding here costs:
//   · The public can no longer see how much benefit tax was withheld. Only the
//     treasuries can, by the coins they receive.
//   · Each treasury receives one coin per claim, and can invert its value to
//     that claim's benefit and final gross. It learns the figures an observer
//     used to learn from the pools — not who claimed.
//   · The claim transaction needs the treasuries' ENCRYPTION keys as well as
//     their coin keys, or it builds coins they can never find.
//
// The rate is flat here; the real UB scheme steps it down after the opening
// months. That belongs in `BenefitParams` as a schedule and isn't modelled.
//
// ⚠️ The fund can't see re-employment — it can't read a payroll ledger — so a
// claimant who finds work keeps claiming until the duration runs out. The
// block-time check paces claims to the calendar; it does not stop them.
export circuit claim(
  path: MerkleTreePath<16, Bytes<32>>,
  leaf: ClaimLeaf,
  // The final month's opening. `gross` is the only figure the benefit uses; the
  // rest are here because the commitment binds all of them and cannot be opened
  // without them.
  gross: Uint<60>,
  tax: Uint<60>,
  social: Uint<60>,
  net: Uint<60>,
  weeks: Uint<8>,
  employer: ZswapCoinPublicKey,
  payrollParamsHash: Bytes<32>,
  nonce: Bytes<32>,
  // Which calendar month is being claimed, with the pieces that pin it.
  calendar: ClaimMonth,
  params: BenefitParams,
  // The tax schedule the benefit is withheld under. Not trusted: pinned below
  // against the `paramsHash` bound into her salary commitment, so it is
  // provably the schedule her final month was taxed under.
  taxParams: TaxParams,
  // The floor divisions, pinned below. Compact has no division operator, so
  // each quotient is supplied and the circuit admits exactly one.
  benefitQ: Uint<60>,
  benefitTaxQ: Uint<60>,
  benefitSocialQ: Uint<60>,
  coin: QualifiedShieldedCoinInfo
): [] {
  const p = disclose(leaf.finalPeriod);
  assert(rootFor.member(p), "no claim tree published for that period");

  // The rules. Recorded by the platform for her final period, so she cannot
  // pick a more generous published version.
  assert(paramsHashFor.member(p), "no benefit rules recorded for that period");
  assert(
    paramsHashFor.lookup(p) == persistentHash<BenefitParams>(disclose(params)),
    "those are not the benefit rules recorded for that period"
  );

  // Membership, as a witness. The leaf is never disclosed, so proving it is in
  // the tree says only "somebody terminated that month is claiming".
  assert(
    path.leaf == persistentHash<ClaimLeaf>(disclose(leaf)),
    "that leaf does not match what was supplied"
  );
  assert(
    merkleTreePathRootNoLeafHash<16>(path).field == rootFor.lookup(p),
    "that leaf is not in the published claim tree for that period"
  );

  // Eligibility. Attested by the employer inside the leaf rather than counted
  // here: the fund cannot read a payroll ledger to count for itself, and a
  // public per-person counter would be a tenure record keyed to one worker.
  // Auditable after the fact — the period count really is public.
  assert(leaf.monthsWorked >= params.minMonths, "not enough months of employment");

  // ── The month ─────────────────────────────────────────────────────────────
  // Counted as year * 12 + month on both sides, so "the Nth month after the
  // final period" needs no division and rolls over December correctly.
  const cal = disclose(calendar);
  assert(cal.finalMonth >= 1, "the final month must be 1-12");
  assert(cal.finalMonth <= 12, "the final month must be 1-12");
  assert(
    (cal.finalYear as Uint<32>) * 100 + (cal.finalMonth as Uint<32>) == p,
    "that year and month are not the final period"
  );
  const finalIndex = (cal.finalYear as Uint<32>) * 12 + (cal.finalMonth as Uint<32>);
  const claimIndex = (cal.year as Uint<32>) * 12 + (cal.month as Uint<32>);
  assert(claimIndex > finalIndex, "a benefit starts the month after the final period");
  assert(
    claimIndex - finalIndex <= params.durationMonths as Uint<32>,
    "that month is beyond this entitlement"
  );
  // Not before the month has begun, by the block's clock, in UTC. `monthStart`
  // also checks the month is 1-12 and pins the leap-year quotients.
  assert(
    blockTimeGte(monthStart(cal.year, cal.month, cal.q4, cal.q100, cal.q400)),
    "that month has not started yet"
  );
  const claimedMonth = ((cal.year as Uint<32>) * 100 + (cal.month as Uint<32>)) as Uint<32>;

  // Hers. Only the holder of the coin key that payroll filed can produce this,
  // which is what stops the employer who wrote the attestation from spending it.
  assert(
    leaf.payeeBinding ==
      persistentHash<PayeeBinding>(
        PayeeBinding { payee: ownPublicKey(), period: p, instance: leaf.instance }
      ),
    "that leaf was not filed for this wallet"
  );

  // The final salary, opened against the commitment payroll published for that
  // month. This is the figure the benefit derives from.
  assert(
    leaf.commitment ==
      persistentHash<PayrollCommitment>(
        PayrollCommitment {
          gross: gross, tax: tax, social: social, net: net,
          weeks: weeks, period: p, employer: employer,
          paramsHash: payrollParamsHash, nonce: nonce
        }
      ),
    "the figures do not open that month's commitment"
  );

  // B = min(gross, cap) x rate. The cap first, then the rate.
  const capped = gross < params.maxMonthlyGross ? gross : params.maxMonthlyGross;
  const numerator = (capped as Uint<76>) * (params.rate as Uint<76>);
  assert((benefitQ as Uint<76>) * 10000 <= numerator, "benefit quotient too small");
  assert(numerator < ((benefitQ as Uint<76>) + 1) * 10000, "benefit quotient too large");
  assert(benefitQ > 0, "the benefit rounds to nothing");

  // ── Withholding on the benefit ──────────────────────────────────────────
  // A benefit is taxable income, so we apply the same tax schedule her final salary was taxed under.
  assert(
    persistentHash<TaxParams>(taxParams) == payrollParamsHash,
    "those are not the tax rules the final month was filed under"
  );

  // Identical to payroll's `bandsFor`, and identical on purpose. Calling it is
  // not possible — no contract here can call another — so the arithmetic is
  // duplicated and `tests/benefit-tax.test.mjs` checks the two against each
  // other rather than leaving the copies to drift.
  const t1 = taxParams.threshold1;
  const t2 = taxParams.threshold2;
  const b1 = benefitQ < t1 ? benefitQ : t1;
  const b2 = benefitQ <= t1 ? 0 : ((benefitQ < t2 ? benefitQ : t2) - t1) as Uint<60>;
  const b3 = benefitQ <= t2 ? 0 : (benefitQ - t2) as Uint<60>;

  const taxN =
    (b1 as Uint<80>) * (taxParams.rate1 as Uint<80>) +
    (b2 as Uint<80>) * (taxParams.rate2 as Uint<80>) +
    (b3 as Uint<80>) * (taxParams.rate3 as Uint<80>);
  assert((benefitTaxQ as Uint<80>) * 10000 <= taxN, "benefit tax quotient too small");
  assert(taxN < ((benefitTaxQ as Uint<80>) + 1) * 10000, "benefit tax quotient too large");

  const contribBase = benefitQ < taxParams.maxContribBase
    ? benefitQ
    : taxParams.maxContribBase;
  const socN = (contribBase as Uint<80>) * (taxParams.contribRate as Uint<80>);
  assert(
    (benefitSocialQ as Uint<80>) * 10000 <= socN,
    "benefit contribution quotient too small"
  );
  assert(
    socN < ((benefitSocialQ as Uint<80>) + 1) * 10000,
    "benefit contribution quotient too large"
  );

  // Strict, and the strictness is the whole of what this adds.
  //
  // The subtraction below cannot silently underflow: Compact checks it and
  // fails with "result of subtraction would be negative" — probed at Uint<8>,
  // where 10 - 6 - 5 is refused and 10 - 6 - 4 yields zero. So the case where
  // withholding EXCEEDS the benefit is caught with or without this line; what
  // this line uniquely rejects is withholding exactly EQUAL to the benefit,
  // which the subtraction would accept as a net of zero.
  //
  // Rejecting it is deliberate. A zero-net claim would burn the month's
  // nullifier — `spent` is inserted below and never removed — and send a coin
  // worth nothing, so the claimant would spend her one claim on that month to
  // receive nothing and could not retry.
  //
  // ⚠️ Unreachable under any sane rule set, and worth knowing before anyone
  // relaxes it: both quotients are FLOOR divisions, so the withholding is at
  // most `benefitQ x (rate + contribRate) / 10000`, and equality needs those
  // rates to sum to 10000 basis points — 100%. The published schedule's worst
  // case is rate3 4950 plus contribRate 300, or 52.5%. Loosening this to `<=`
  // would therefore change no claim that can currently be made; it would only
  // admit a net of zero if a rule set with 100% combined withholding were ever
  // published, which is the one case where failing is right.
  assert(
    benefitTaxQ + benefitSocialQ < benefitQ,
    "withholding leaves nothing of the benefit"
  );
  // What actually reaches her. The withheld part goes to the treasuries below.
  const benefitNet = (benefitQ - benefitTaxQ - benefitSocialQ) as Uint<60>;

  // Once per month. Fresh-then-inserted, so a replay inside one transaction
  // cannot slip through between the two.
  const nullifier = persistentHash<ClaimNullifier>(
    ClaimNullifier {
      payee: ownPublicKey(),
      month: claimedMonth,
      fund: kernel.self().bytes
    }
  );
  assert(!spent.member(disclose(nullifier)), "already claimed for that month");
  spent.insert(disclose(nullifier));

  assert(benefitToken == disclose(coin.color), "wrong token for this fund");

  // The coin must hold MORE than the whole benefit — net and withholding both,
  // and at least one unit over.
  //
  // More than the benefit, because all of it leaves in this circuit. The
  // strict inequality is what guarantees change after every one of the three
  // sends, so each send below has a coin to spend and the fund always keeps a
  // coin back.
  //
  // Not exact, unlike payroll. Payroll requires an exact coin because a
  // remainder there would be stranded; here `sendShielded` splits, returning
  // the remainder to this contract. And exactness would leak: sizing a coin to
  // the benefit means knowing the benefit, which derives from her private
  // salary — so whoever prepared the coin would have to be told the figure this
  // contract exists to hide.
  assert(
    coin.value > benefitQ as Uint<128>,
    "the pool coin cannot cover the benefit"
  );

  // Three sends, chained through the change. The first spends a coin already
  // in the Zswap tree; the other two spend change created a moment earlier in
  // this same transaction, which is what `sendImmediateShielded` is for.
  //
  // ⚠️ Run in the local runtime, not yet on chain. Untested on chain: spending
  // change in the same transaction, and a zero-value send, which a rule set
  // with a zero rate would produce for the tax or the contribution.
  const toClaimant = sendShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
    disclose(benefitNet) as Uint<128>
  );
  const toTax = sendImmediateShielded(
    toClaimant.change.value,
    left<ZswapCoinPublicKey, ContractAddress>(taxTreasury),
    disclose(benefitTaxQ) as Uint<128>
  );
  const toSocial = sendImmediateShielded(
    toTax.change.value,
    left<ZswapCoinPublicKey, ContractAddress>(socialTreasury),
    disclose(benefitSocialQ) as Uint<128>
  );
  assert(toSocial.change.is_some, "the pool coin cannot cover the benefit");

  // The surviving change's ordinal, so the pool can be found again. The two
  // intermediate change coins are spent in this transaction and never counted.
  // The nonce is NOT recorded: it is derivable from the spent coin's, and
  // publishing it alongside the public coin commitment would let anyone try
  // candidate values until one matched — recovering the pool balance, and with
  // it every benefit, from the differences between claims.
  poolOrdinal = coinsReceived;
  coinsReceived = (coinsReceived + 1) as Uint<32>;

  claimsPaid.increment(1);
}

// ── Tree construction, exposed ───────────────────────────────────────────────
//
// The relay builds the period's tree off chain, and it must hash exactly as
// `merkleTreePathRoot` does or every path it produces verifies against nothing.
// Rather than reimplement `degradeToTransient` and `transientHash` in
// TypeScript and hope they agree, the relay calls these — the same code the
// claim circuit runs. This is the pattern payroll uses for `commitmentFor` and
// `payeeHash`, for the same reason.

/** The leaf hash that goes into the tree. */
export pure circuit leafDigest(leaf: ClaimLeaf): Bytes<32> {
  return persistentHash<ClaimLeaf>(leaf);
}

/** A leaf hash as the tree sees it. */
export pure circuit treeLeaf(digest: Bytes<32>): Field {
  return degradeToTransient(digest);
}

/** One interior node. */
export pure circuit treeNode(leftNode: Field, rightNode: Field): Field {
  return transientHash<Vector<2, Field>>([leftNode, rightNode]);
}

/**
 * The root a path proves membership of, exposed so the relay can check its own
 * work. A tree builder that hashes differently from the circuit produces paths
 * that verify against nothing, and the failure surfaces at a claimant's claim —
 * the worst possible place to discover it. Being able to assert
 * `pathRoot(path) == root` in a test moves that discovery to the build.
 */
export pure circuit pathRoot(path: MerkleTreePath<16, Bytes<32>>): Field {
  return merkleTreePathRootNoLeafHash<16>(path).field;
}

/**
 * The hash a tax schedule must produce to be accepted.
 *
 * Exposed so a claimant can check her copy of the rules against PAYROLL's
 * `paramsHashFor` for her final period (not this contract's, which holds
 * benefit rules) BEFORE she proves, rather than discovering
 * the mismatch as a failed assertion after two minutes of proving. The same
 * reason `pathRoot` is exposed.
 */
export pure circuit taxParamsHash(params: TaxParams): Bytes<32> {
  return persistentHash<TaxParams>(params);
}

/**
 * The hash a benefit rule set is published and recorded under.
 *
 * `paramsFor` and `paramsHashFor` hold only this hash, so a client holding the
 * published figures needs it to find which version the platform recorded for a
 * final period — and to check its copy before proving, rather than as a failed
 * assertion afterwards. The same reason `taxParamsHash` is exposed.
 */
export pure circuit benefitParamsHash(params: BenefitParams): Bytes<32> {
  return persistentHash<BenefitParams>(params);
}

// monthStart: the first second of a calendar month, UTC, as seconds since
// 1970-01-01 — what `claim` compares the block time against.
//
// Exposed for the same reason as `pathRoot`: the claimant's client can compute
// the quotients, call this, and learn locally whether a month has started,
// instead of finding out as a failed proof.
//
// Compact has no division, so leap-ness can't be tested directly. The caller
// supplies floor(year / 4), floor(year / 100) and floor(year / 400); each is
// pinned by q * d <= year < (q + 1) * d, which admits exactly one q.
//
// Days before the year: 365 per year since 1970, plus the leap days in
// between. The leap years strictly before `year` number
// floor((year-1)/4) - floor((year-1)/100) + floor((year-1)/400), less the 477
// that fall before 1970. floor((year-1)/d) is q, less one when d divides year.
export pure circuit monthStart(
  year: Uint<16>,
  month: Uint<8>,
  q4: Uint<16>,
  q100: Uint<16>,
  q400: Uint<16>
): Uint<64> {
  assert(month >= 1, "month must be 1-12");
  assert(month <= 12, "month must be 1-12");
  assert(year >= 1970, "year must be 1970 or later");

  const y = year as Uint<64>;
  const d4 = q4 as Uint<64>;
  const d100 = q100 as Uint<64>;
  const d400 = q400 as Uint<64>;
  assert(d4 * 4 <= y, "year / 4 quotient too large");
  assert(y < (d4 + 1) * 4, "year / 4 quotient too small");
  assert(d100 * 100 <= y, "year / 100 quotient too large");
  assert(y < (d100 + 1) * 100, "year / 100 quotient too small");
  assert(d400 * 400 <= y, "year / 400 quotient too large");
  assert(y < (d400 + 1) * 400, "year / 400 quotient too small");

  const div4 = d4 * 4 == y;
  const div100 = d100 * 100 == y;
  const div400 = d400 * 400 == y;
  const leap = div4 && (!div100 || div400);

  // year >= 1970 keeps every quotient well above zero, so these never underflow.
  const f4 = div4 ? (d4 - 1) as Uint<64> : d4;
  const f100 = div100 ? (d100 - 1) as Uint<64> : d100;
  const f400 = div400 ? (d400 - 1) as Uint<64> : d400;
  const yearStart = (365 * (y - 1970) + (f4 - f100) + f400 - 477) as Uint<64>;

  const before: Uint<64> =
    month == 1 ? 0 : month == 2 ? 31 : month == 3 ? 59 : month == 4 ? 90 :
    month == 5 ? 120 : month == 6 ? 151 : month == 7 ? 181 : month == 8 ? 212 :
    month == 9 ? 243 : month == 10 ? 273 : month == 11 ? 304 : 334;
  const leapDay: Uint<64> = (leap && month > 2) ? 1 : 0;

  return ((yearStart + before + leapDay) * 86400) as Uint<64>;
}


// claimNullifier: the nullifier for one wallet in one calendar month, exposed so
// a claimant can check the public `spent` set for herself.
//
// `claim` builds the identical value and refuses a month already in `spent`.
// Without this a claimant had no way to ask "have I already claimed for that
// month?" — the set is public, but every entry is an opaque image, and finding
// her own means computing it.
//
// `fund` is a parameter rather than `kernel.self()`, which a pure circuit
// cannot call. The caller passes this contract's address; passing another
// yields a nullifier from a different fund's set — a wrong answer, not a leak.
//
// ⚠️ This is computable by anyone who has her coin public key, which is an
// address she hands out to be paid. That is the trade recorded on
// `ClaimNullifier`: the wallet key replaced a secret claim key, and
// unlinkability went with it. Exposing the circuit doesn't widen the exposure —
// the inputs were already public — but it does make it convenient, so checking
// should still be a LOCAL act. Asking an indexer whether one nullifier is
// present hands that indexer the linkage directly.
export pure circuit claimNullifier(
  payee: ZswapCoinPublicKey,
  month: Uint<32>,
  fund: Bytes<32>
): Bytes<32> {
  return persistentHash<ClaimNullifier>(
    ClaimNullifier { payee: payee, month: month, fund: fund }
  );
}
