pragma language_version >= 0.16;

import CompactStandardLibrary;

// Holds the withheld wage tax that leaves a payroll contract.
//
// The counterpart to `fund.compact`. That contract exists to PAY people, so it
// needs published rules, per-period anchors and a claim circuit that proves
// entitlement without revealing who is claiming. This one has no claimants.
// What it needs is custody with an audit trail: money arrives against a stated
// period, and money leaves only one way.
//
// ⚠️ DEMO SCOPE. Collects withheld wage tax and records it per month.
//
// The tax does not arrive here directly: `payroll.remit` sends it to the
// operator's treasury WALLET, and the operator then calls `deposit` — two
// transactions, because a contract can only receive a coin in a circuit it runs
// itself, and one contract cannot call another's circuit on Midnight today.
// A keypair sits between the two hops, so nothing here can verify that what was
// deposited matches what was remitted.
//
// Nothing consumes the receipts yet. `receivedFor` and `sourceFor` are written
// and never read — no circuit in this system checks that a period's tax
// actually arrived. They exist so a verifier can compare them against the
// payroll contract off chain, and so a future benefit or compliance circuit has
// something to point at.

export ledger authority: ZswapCoinPublicKey;

// The token this vault holds, frozen at deploy. A vault that silently mixed
// tokens would make every total below meaningless.
//
// ⚠️ It used to be set by the FIRST COIN RECEIVED. Since deposits are
// permissionless, anyone could send one dust unit of a token they minted
// themselves, pin `token` to it, and every real remittance afterwards would
// fail `wrong token for this vault` — permanently, since nothing can reset it.
// Nothing stolen, vault bricked, attacker's cost one self-minted coin.
//
// Setting it at deploy closes the window entirely. The price is a deploy-order
// dependency: the token must exist before the vault.
export ledger token: Bytes<32>;

// How much tax arrived for each period. Maps are key → value, so this is
// period (YYYYMM) → amount in minor units.
export ledger receivedFor: Map<Uint<32>, Uint<64>>;

// Which payroll contract a period's deposit said it came from.
// key = the period, YYYYMM
// value = the payroll contract's address, 32 bytes
// Employers never deposit here, as we can't send directly between contracts yet on Midnight.
// So the operator does, after the coin reaches their treasury wallet. 
// So this is the operator's claim about where the money originated, and the vault cannot check it.
export ledger sourceFor: Map<Uint<32>, Bytes<32>>;

// Running totals
export ledger heldTotal: Uint<64>;
export ledger receivedTotal: Uint<64>;
export ledger withdrawnTotal: Uint<64>;

// Counters for how many deposits and withdrawals have been made.
export ledger depositCount: Uint<32>;
export ledger withdrawalCount: Uint<32>;

// How many coins this contract has received. Each deposit gets the next number.
export ledger coinsReceived: Uint<32>;

// Constructor: initialize the vault with the authority and token it will hold.
constructor(withdrawTo: ZswapCoinPublicKey, holds: Bytes<32>) {
  authority = disclose(withdrawTo);
  token = disclose(holds);
  heldTotal = 0;
  receivedTotal = 0;
  withdrawnTotal = 0;
  depositCount = 0;
  withdrawalCount = 0;
  coinsReceived = 0;
}

// Pays withheld tax into the vault, against the month it covers.
//
// Anyone may call this. Gating it would protect nothing — the failure worth
// worrying about is money NOT arriving, and no access check prevents that.
//
// `amount` is passed in and then checked against the coin, rather than read off
// `coin.value`: coin values are Uint<128> and these totals are Uint<64>, and
// Compact won't narrow between them. Same pattern as `payroll.compact` — state
// the figure, then assert the coin holds it.
export circuit deposit(
  period: Uint<32>,
  source: Bytes<32>,
  amount: Uint<64>,
  coin: ShieldedCoinInfo
): [] {
  const p = disclose(period);
  // A shape check, not a calendar one — same bounds as `setPayroll`. Catches a
  // typo that would file money under a month nobody thinks to look in.
  assert(p >= 200001, "period must be YYYYMM, e.g. 202609");
  assert(p <= 299912, "period must be YYYYMM, e.g. 202609");
  assert(disclose(amount) > 0, "a deposit of nothing records nothing");

  assert(token == disclose(coin.color), "wrong token for this vault");
  assert(coin.value == disclose(amount) as Uint<128>, "coin does not hold the stated amount");

  receiveShielded(disclose(coin));
  coinsReceived = (coinsReceived + 1) as Uint<32>;

  // Added to, not replaced: a month can be paid in instalments, or by two
  // payroll contracts. The total for a period is everything that arrived for it.
  const already = receivedFor.member(p) ? receivedFor.lookup(p) : 0;
  receivedFor.insert(p, (already + disclose(amount)) as Uint<64>);

  // First deposit for a period sets the source; later ones don't change it. One
  // field can't name several sources, so it names where the money started.
  if (!sourceFor.member(p)) {
    sourceFor.insert(p, disclose(source));
  }

  heldTotal = (heldTotal + disclose(amount)) as Uint<64>;
  receivedTotal = (receivedTotal + disclose(amount)) as Uint<64>;
  depositCount = (depositCount + 1) as Uint<32>;
}

// Hands the withdrawal seat to a new key. Current holder only.
// Grants nothing new — the holder can already withdraw everything. It exists so
// a lost key doesn't make the balance permanently unwithdrawable.
export circuit transferAuthority(newAuthority: ZswapCoinPublicKey): [] {
  assert(ownPublicKey() == authority, "only the authority may transfer the seat");

  authority = disclose(newAuthority);
}

// Moves money out, to the authority and nowhere else.
//
// There is no destination argument: the money goes to whoever holds the
// authority key, and only they can call this. Triggering and receiving are the
// same party, so there is nothing to redirect.
//
// Every withdrawal is a transaction on this contract and bumps the counters
// below. That is the difference from a wallet: a wallet balance can drop with
// nothing on chain saying anything was withdrawn.
//
// Withdraws ONE coin at a time, and `amount` must equal that coin's full value
// — coins are not merged or split here, so the vault pays out in the same
// denominations it received.
export circuit withdraw(amount: Uint<64>, coin: QualifiedShieldedCoinInfo): [] {
  assert(ownPublicKey() == authority, "only the authority may withdraw");
  assert(token == disclose(coin.color), "wrong token for this vault");
  assert(coin.value == disclose(amount) as Uint<128>, "coin does not hold the stated amount");
  assert(disclose(amount) <= heldTotal, "cannot withdraw more than the vault holds");

  sendShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(authority),
    disclose(amount) as Uint<128>
  );

  heldTotal = (heldTotal - disclose(amount)) as Uint<64>;
  withdrawnTotal = (withdrawnTotal + disclose(amount)) as Uint<64>;
  withdrawalCount = (withdrawalCount + 1) as Uint<32>;
}