pragma language_version >= 0.16;

import CompactStandardLibrary;

// A counter that exists to answer one question about the LEDGER, not about payroll.
//
// ── What is being tested ───────────────────────────────────────────────────
//
// Can a single Midnight transaction carry calls to TWO different contracts, and
// do both land or neither? Everything in the payroll strategy hangs off that:
// if it works, the employer's net deposit and the two national deposits can be
// one atomic act, and no reconciliation problem exists. If it does not, the
// three deposits are independent and can disagree, and the design needs a
// receipt-then-release or an escrow-and-pull shape to close the gap.
//
// `incomelayerzk-constraints` records that `Intent.addCall` is repeatable and
// `Transaction.addCalls` takes an array, established by reading the ledger API.
// What it does not record is whether such a transaction VALIDATES and APPLIES on
// chain, which is the part a strategy can actually rest on. That needs a
// transaction, a node, and a state read afterwards.
//
// ── Why a counter, and why it holds no coins ───────────────────────────────
//
// Deliberately the smallest contract that can prove it ran. A coin operation
// would drag in Zswap offers, which must be merged across the two calls and are
// their own source of failure — and a failure there would say nothing about the
// question. With no coins there are no offers, so a two-call transaction differs
// from a one-call transaction in exactly one respect: the number of calls.
//
// Two INSTANCES of this one contract stand in for two different contracts. What
// the ledger sees is two distinct `ContractAddress`es in one intent, which is
// the same shape as payroll + tax + social, at a third of the compile time.

// How many times `bump` has run on this instance.
export ledger count: Uint<64>;

// Who called last. Written so a successful call is visible in state even if two
// instances somehow shared a counter — if both instances end up naming the same
// caller and the same count, the test is reading one contract twice rather than
// two contracts once.
export ledger lastCaller: ZswapCoinPublicKey;

// Set by the caller on each bump, so the two calls in one transaction can be
// told apart in the state afterwards. A transaction that lands with tag 1 on one
// instance and tag 2 on the other is unambiguous evidence that both calls in it
// executed, which a bare counter could not distinguish from one call retried.
export ledger lastTag: Uint<32>;

constructor() {
  count = 0;
  lastTag = 0;
}

// Unrestricted on purpose. This contract holds nothing and guards nothing; an
// access check would only add a way for the test to fail for a reason unrelated
// to what it is testing.
export circuit bump(tag: Uint<32>): [] {
  count = (count + 1) as Uint<64>;
  lastCaller = disclose(ownPublicKey());
  lastTag = disclose(tag);
}
