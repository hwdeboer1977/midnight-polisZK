# Midnight Network Configuration
# Copy this file to .env and fill in your values

# Network: local | preprod | preview
# `local` targets the docker stack in compose.yml plus a standalone proof server.
# For a remote network, match whatever your wallet app shows — the address
# prefix tells you which one: mn_addr_preprod1... vs mn_addr_preview1...
MIDNIGHT_NETWORK=local

PROOF_SERVER_URL=http://127.0.0.1:6300

# Wallet (KEEP PRIVATE — never commit, never paste into a chat or an issue)
#
# Not needed on `local`: the devnet dev preset pre-funds a well-known seed and
# the app falls back to it.
#
# For a remote network, set exactly ONE of the following:
#
#   WALLET_MNEMONIC — the 24-word recovery phrase from a browser wallet
#     (Lace, IAM). This is what those wallets export; they never hand out a
#     raw private key. Derivation matches the Midnight SDK exactly, so the
#     address below will equal the one your wallet app shows.
#
#   WALLET_SEED — a 64-character hex master seed, if you have one directly.
#
# WALLET_MNEMONIC="word1 word2 word3 ... word24"
# WALLET_SEED=your_64_character_wallet_seed_here

# Contract Configuration
# Set by the deploy scripts; only used by the bare `npm run deploy`.
CONTRACT_NAME=payroll

# Development Settings
DEBUG_LEVEL=info

# Registration database (docker compose service `postgres`)
#
# Platform bookkeeping only: which company registered, when, for how long, and
# whether they are still active. It is never authoritative over the chain — the
# payroll contract remains the only answer to who controls a payroll.
#
# Start it with `npm run db:up`. The default matches compose.yml.
# DATABASE_URL=postgresql://polis:polis@127.0.0.1:5436/polis

# How long a registration lasts before it counts as expired. Default: 12.
# REGISTRATION_TERM_MONTHS=12

# ── Platform backend (`npm run server`) ──────────────────────────────────────
#
# Onboarding, the faucet and fund+pay sign with the PLATFORM wallet, so anyone
# who can reach those routes and authenticate can spend it.
#
# Default is 127.0.0.1, where nothing off-machine can reach them and no token is
# needed. Binding anywhere else REQUIRES PLATFORM_API_TOKEN — the process refuses
# to start otherwise, so "deployed it and forgot the token" fails at boot rather
# than silently.
#
# On a managed host that routes traffic in (detected by RENDER), the default
# becomes 0.0.0.0, because loopback there means the router's port scan finds
# nothing and the deploy times out. The token requirement is unchanged: a
# managed host with no token still refuses to start.
#
# SERVER_HOST overrides the default either way. SERVER_PORT wins over PORT,
# which is what a PaaS assigns.
#
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8787
#
# At least 24 characters. Generate with: openssl rand -hex 32
# PLATFORM_API_TOKEN=
#
# Origins allowed to call this, comma-separated. Needed once the frontend is
# hosted somewhere other than this machine. Unset means any origin.
#
# No trailing slash — a browser sends `Origin:` with no path. One is stripped if
# present, since the failure it causes (every request refused by CORS) looks
# nothing like the typo that caused it.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Self-service signup ──────────────────────────────────────────────────────
#
# Two routes are PUBLIC — they have to be, since a stranger is the one calling
# them — and bounded rather than authenticated.
#
# `/api/onboard`: what it can cost is transaction fees and an unwanted contract;
# what it cannot is pEUR, because the contract is assigned to the caller's own
# key.
#
# `/api/claim`: the starter allowance, which does mint. Bounded by the chain
# instead — the key must already be an employer of a payroll contract, must not
# have claimed before, and the amount is fixed by the server. One allowance per
# registered employer, forever, which is a tighter cap than a shared token gives.
# It needs DATA_DIR set on a managed host: claims.json is where "has not claimed
# before" is remembered, and a redeploy that loses it forgives everyone.
#
# The faucet, mint and fund+pay routes stay behind PLATFORM_API_TOKEN. Those mint
# an amount the CALLER picks, with no ceiling and no once-only record, or move an
# employer's money — no rate limit would make them safe to publish.
#
# Set SIGNUP_CODE to turn open signup into invite-only. It is handed to
# prospective employers and IS expected to reach a browser — unlike
# PLATFORM_API_TOKEN, which must never. Unset means anyone who can reach the
# service may sign up. It guards signup only: a claim can only pay a key that
# already has a contract, so it has already passed this gate.
# SIGNUP_CODE=
#
# Signups one address may start per hour, and separately claim attempts. Each
# route has its own bucket, so claiming right after signing up never trips the
# other one. Default 3.
# SIGNUP_LIMIT_PER_HOUR=3

# ── Where run-time state lives ───────────────────────────────────────────────
#
# Three files are written at run time and are not source: deployment.json (what
# has been deployed), .onboarded-keys.json (who has signed up) and .wallet-state
# (the wallet's sync position). They default to the working directory, which is
# right on a developer's machine and wrong on a managed host — there the code
# directory is REPLACED on every deploy, so a contract deployed today is
# orphaned by tomorrow's push. It stays on chain, permanently bound to its
# employer, with nothing left that knows its address.
#
# On Render: attach a disk and point this at its mount path.
# DATA_DIR=/var/data
