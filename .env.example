# Midnight Network Configuration
# Copy this file to .env and fill in your values

# Network: local | preprod | preview
# `local` targets the docker stack in compose.yml plus a standalone proof server.
MIDNIGHT_NETWORK=local

PROOF_SERVER_URL=http://127.0.0.1:6300

# Wallet (KEEP PRIVATE!)
# Not needed on `local`: the devnet dev preset pre-funds a well-known seed and
# the app falls back to it. Required for preprod/preview — fund the unshielded
# address printed by `npm run check-balance` at that network's faucet.
# WALLET_SEED=your_64_character_wallet_seed_here

# Contract Configuration
CONTRACT_NAME=hello-world

# Development Settings
DEBUG_LEVEL=info
